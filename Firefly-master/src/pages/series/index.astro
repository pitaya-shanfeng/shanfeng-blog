---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { seriesConfig } from "@/config/seriesConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

const posts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

const seriesList = seriesConfig.map((series) => {
	const seriesPosts = posts.filter((post) => post.data.series === series.name);
	return {
		...series,
		count: seriesPosts.length,
		groups: series.groups || [],
	};
});
---

<MainGridLayout title="合集" description="按连续主题整理的阅读路径">
	<div class="card-base px-8 py-6 mb-4">
		<div class="text-2xl font-bold text-(--primary) mb-2">合集</div>
		<p class="text-30 text-sm">按连续主题整理的阅读路径 · {seriesList.length} 个合集</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
		{
			seriesList.map((series, index) => (
				<a
					href={url(`/series/${series.slug}/`)}
					class="card-base p-6 group onload-animation"
					style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms);`}
				>
					<div class="flex items-start gap-4">
						<div class="shrink-0 w-14 h-14 rounded-full bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors">
							<Icon is:inline name="material-symbols:library-books-outline-rounded" class="text-3xl text-(--primary)" />
						</div>
						<div class="flex-1 min-w-0">
							<h2 class="text-xl font-bold text-90 group-hover:text-(--primary) transition-colors">
								{series.name}
							</h2>
							<p class="text-sm text-50 mt-2 leading-6">{series.description}</p>
							<div class="flex flex-wrap gap-2 mt-4">
								{series.groups.map((group) => (
									<span class="text-xs rounded-full px-2.5 py-1 bg-black/5 dark:bg-white/10 text-50">{group}</span>
								))}
							</div>
							<p class="text-sm text-30 mt-4 group-hover:text-(--primary)/70 transition-colors">
								{series.count} 篇文章
							</p>
						</div>
						<Icon is:inline name="material-symbols:chevron-right-rounded" class="text-2xl text-30 group-hover:text-(--primary) transition-colors" />
					</div>
				</a>
			))
		}
	</div>
</MainGridLayout>
