---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import { seriesConfig } from "@/config/seriesConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { countMarkdownWords } from "@/utils/word-count";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 获取所有文章
const posts = await getSortedPosts();
const dynamics = siteConfig.pages.dynamic ? await getCollection("dynamic") : [];
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	totalWords += countMarkdownWords(post.body);
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

type StatItem = {
	icon: string;
	label: string;
	value: number;
	href?: string;
	formatted?: boolean;
	id?: string;
	suffix?: string;
};

const stats: StatItem[] = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
		href: "/",
	},
	...(siteConfig.pages.dynamic
		? [
				{
					icon: "material-symbols:dynamic-feed-rounded",
					label: i18n(I18nKey.siteStatsDynamicCount),
					value: dynamics.length,
				},
			]
		: []),
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
		href: "/categories/",
	},
	{
		icon: "material-symbols:library-books-outline-rounded",
		label: "合集",
		value: seriesConfig.length,
		href: "/series/",
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
		href: "/tags/",
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => {
      const ContentTag = stat.href ? "a" : "div";
      return (
      <ContentTag href={stat.href} class:list={[
        "flex items-center justify-between px-3 py-1.5 rounded-lg transition-colors",
        stat.href && "hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active)"
      ]}>
        <div class="flex items-center gap-2.5">
          <div class="text-(--primary) text-xl">
            <Icon is:inline name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="ml-1 text-sm text-neutral-500 dark:text-neutral-400">
              {stat.suffix}
            </span>
          )}
        </div>
      </ContentTag>
    )})}
  </div>
</WidgetLayout>
