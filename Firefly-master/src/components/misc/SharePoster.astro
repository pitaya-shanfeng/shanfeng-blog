---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
  title: string;
  author: string;
  description?: string;
  pubDate: string;
  coverImage?: string | null;
  url: string;
  siteTitle: string;
  avatar?: string | null;
}

const {
  title,
  author,
  description = "",
  pubDate,
  coverImage = null,
  url,
  siteTitle,
  avatar = null,
} = Astro.props;

const widgetId = `share-poster-${Math.random().toString(36).slice(2, 9)}`;
const shareArticleText = i18n(I18nKey.shareArticle);
const generatingPosterText = i18n(I18nKey.generatingPoster);
const copiedText = i18n(I18nKey.copied);
const copyLinkText = i18n(I18nKey.copyLink);
const authorText = i18n(I18nKey.author);
const scanToReadText = i18n(I18nKey.scanToRead);
---

<div id={widgetId} data-share-poster class="inline-block">
  <button
    type="button"
    class="btn-regular rounded-lg h-12 px-6 gap-2 hover:scale-105 active:scale-95 whitespace-nowrap"
    aria-label="Generate Share Poster"
    data-share-trigger
  >
    <span aria-hidden="true">↗</span>
    <span>{shareArticleText}</span>
  </button>
</div>

<script type="module" define:vars={{ widgetId, title, author, description, pubDate, coverImage, url, siteTitle, avatar, generatingPosterText, copiedText, copyLinkText, authorText, scanToReadText }}>
  (() => {
    const root = document.getElementById(widgetId);
    if (!root) return;

    const trigger = root.querySelector("[data-share-trigger]");
    if (!trigger) return;

    const state = {
      showModal: false,
      posterImage: null,
      generating: false,
      copied: false,
      themeColor: "#558e88",
    };

    const mount = document.createElement("div");
    mount.className =
      "fixed inset-0 z-9999 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 transition-opacity hidden";
    document.body.appendChild(mount);

    function escapeHtml(value) {
      return String(value).replace(/[&<>"]/g, (ch) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
      })[ch]);
    }

    function renderModal() {
      mount.innerHTML = `
        <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-[440px] w-full max-h-[90vh] overflow-y-auto flex flex-col shadow-2xl transform transition-all">
          <div class="p-6 flex justify-center bg-gray-50 dark:bg-gray-900 min-h-[200px] items-center">
            ${
              state.posterImage
                ? `<img src="${state.posterImage}" alt="Poster" class="max-w-full h-auto shadow-lg rounded-lg" />`
                : `<div class="flex flex-col items-center gap-3"><div class="w-8 h-8 border-2 border-gray-200 rounded-full animate-spin" style="border-top-color: ${state.themeColor}"></div><span class="text-sm text-gray-500">${escapeHtml(generatingPosterText)}</span></div>`
            }
          </div>
          <div class="p-4 border-t border-gray-100 dark:border-gray-700">
            <button type="button" data-copy-btn class="py-3 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl font-medium hover:bg-gray-200 dark:hover:bg-gray-600 active:scale-[0.98] transition-all flex items-center justify-center gap-2 w-full">
              ${
                state.copied
                  ? `<span>${escapeHtml(copiedText)}</span>`
                  : `<span>${escapeHtml(copyLinkText)}</span>`
              }
            </button>
          </div>
        </div>
      `;
      mount.classList.toggle("hidden", !state.showModal);

      const panel = mount.firstElementChild;
      if (panel) {
        panel.addEventListener("click", (e) => e.stopPropagation());
      }

      const copyBtn = mount.querySelector("[data-copy-btn]");
      if (copyBtn) {
        copyBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(url);
            state.copied = true;
            renderModal();
            setTimeout(() => {
              state.copied = false;
              if (state.showModal) renderModal();
            }, 2000);
          } catch {
            alert(url);
          }
        });
      }
    }

    function closeModal() {
      state.showModal = false;
      renderModal();
    }

    mount.addEventListener("click", closeModal);

    function loadImage(src) {
      return new Promise((resolve) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => resolve(img);
        img.onerror = () => {
          if (!src || src.includes("images.weserv.nl")) {
            resolve(null);
            return;
          }
          const proxyUrl = `https://images.weserv.nl/?url=${encodeURIComponent(src)}&output=png`;
          const proxyImg = new Image();
          proxyImg.crossOrigin = "anonymous";
          proxyImg.onload = () => resolve(proxyImg);
          proxyImg.onerror = () => resolve(null);
          proxyImg.src = proxyUrl;
        };
        img.src = src;
      });
    }

    function getLines(ctx, text, maxWidth) {
      const chars = text.split("");
      const lines = [];
      let currentLine = "";
      for (const char of chars) {
        if (ctx.measureText(currentLine + char).width < maxWidth) {
          currentLine += char;
        } else {
          lines.push(currentLine);
          currentLine = char;
        }
      }
      if (currentLine) lines.push(currentLine);
      return lines;
    }

    function drawRoundedRect(ctx, x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    async function generatePoster() {
      state.showModal = true;
      renderModal();
      if (state.posterImage || state.generating) return;

      state.generating = true;
      renderModal();
      try {
        const temp = document.createElement("div");
        temp.style.color = "var(--primary)";
        temp.style.display = "none";
        document.body.appendChild(temp);
        const computedColor = getComputedStyle(temp).color;
        document.body.removeChild(temp);
        if (computedColor) state.themeColor = computedColor;

        const scale = 2;
        const width = 425 * scale;
        const padding = 24 * scale;
        const minPosterHeight = 560 * scale;

        const [coverImg, avatarImg] = await Promise.all([
          coverImage ? loadImage(coverImage) : Promise.resolve(null),
          avatar ? loadImage(avatar) : Promise.resolve(null),
        ]);

        const canvas = document.createElement("canvas");
        const ctx = canvas.getContext("2d");
        if (!ctx) throw new Error("Canvas context not available");

        canvas.width = width;
        canvas.height = 1000 * scale;

        const contentWidth = width - padding * 2;
        let currentY = 0;
        const coverHeight = (coverImage ? 255 : 160) * scale;
        currentY += coverHeight + 30 * scale;

        ctx.font = `700 ${24 * scale}px 'Roboto', sans-serif`;
        const titleLines = getLines(ctx, title, contentWidth);
        const titleLineHeight = 34 * scale;
        const titleHeight = titleLines.length * titleLineHeight;
        currentY += titleHeight + 18 * scale;

        let descHeight = 0;
        if (description) {
          ctx.font = `${14 * scale}px 'Roboto', sans-serif`;
          const descLines = getLines(ctx, description, contentWidth - 16 * scale).slice(0, 6);
          const descLineHeight = 28 * scale;
          descHeight = descLines.length * descLineHeight;
          currentY += descHeight + 8 * scale;
        } else {
          currentY += 16 * scale;
        }

        currentY += 32 * scale;
        const footerHeight = 72 * scale;
        currentY += footerHeight + 30 * scale;

        canvas.height = Math.max(currentY, minPosterHeight);
        const extraVerticalSpace = canvas.height - currentY;

        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.save();
        ctx.globalAlpha = 0.1;
        ctx.fillStyle = state.themeColor;
        ctx.beginPath();
        ctx.arc(width - 25 * scale, 25 * scale, 75 * scale, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(10 * scale, canvas.height - 10 * scale, 50 * scale, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        let dateObj = null;
        try {
          const d = new Date(pubDate);
          if (!Number.isNaN(d.getTime())) {
            dateObj = {
              day: d.getDate().toString().padStart(2, "0"),
              month: (d.getMonth() + 1).toString().padStart(2, "0"),
              year: d.getFullYear().toString(),
            };
          }
        } catch {}

        if (coverImg) {
          const imgRatio = coverImg.width / coverImg.height;
          const targetRatio = width / coverHeight;
          let sx;
          let sy;
          let sWidth;
          let sHeight;
          if (imgRatio > targetRatio) {
            sHeight = coverImg.height;
            sWidth = sHeight * targetRatio;
            sx = (coverImg.width - sWidth) / 2;
            sy = 0;
          } else {
            sWidth = coverImg.width;
            sHeight = sWidth / targetRatio;
            sx = 0;
            sy = (coverImg.height - sHeight) / 2;
          }
          ctx.drawImage(coverImg, sx, sy, sWidth, sHeight, 0, 0, width, coverHeight);
        } else {
          ctx.save();
          ctx.fillStyle = state.themeColor;
          ctx.globalAlpha = 0.2;
          ctx.fillRect(0, 0, width, coverHeight);
          ctx.restore();
        }

        if (dateObj) {
          const dateBoxW = 60 * scale;
          const dateBoxH = 60 * scale;
          const dateBoxX = padding;
          const dateBoxY = coverHeight - dateBoxH;
          ctx.fillStyle = "rgba(0, 0, 0, 0.3)";
          drawRoundedRect(ctx, dateBoxX, dateBoxY, dateBoxW, dateBoxH, 4 * scale);
          ctx.fill();
          ctx.fillStyle = "#ffffff";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.font = `700 ${30 * scale}px 'Roboto', sans-serif`;
          ctx.fillText(dateObj.day, dateBoxX + dateBoxW / 2, dateBoxY + 24 * scale);
          ctx.beginPath();
          ctx.strokeStyle = "rgba(255, 255, 255, 0.6)";
          ctx.lineWidth = 1 * scale;
          ctx.moveTo(dateBoxX + 10 * scale, dateBoxY + 42 * scale);
          ctx.lineTo(dateBoxX + dateBoxW - 10 * scale, dateBoxY + 42 * scale);
          ctx.stroke();
          ctx.font = `${10 * scale}px 'Roboto', sans-serif`;
          ctx.fillText(`${dateObj.year} ${dateObj.month}`, dateBoxX + dateBoxW / 2, dateBoxY + 51 * scale);
        }

        let drawY = coverHeight + 30 * scale;
        ctx.textBaseline = "top";
        ctx.textAlign = "left";
        ctx.font = `700 ${24 * scale}px 'Roboto', sans-serif`;
        ctx.fillStyle = "#111827";
        titleLines.forEach((line) => {
          ctx.fillText(line, padding, drawY);
          drawY += titleLineHeight;
        });
        drawY += 18 * scale - (titleLineHeight - 24 * scale);

        if (description) {
          ctx.fillStyle = "#e5e7eb";
          drawRoundedRect(ctx, padding, drawY - 8 * scale, 4 * scale, descHeight + 8 * scale, 2 * scale);
          ctx.fill();
          ctx.font = `${14 * scale}px 'Roboto', sans-serif`;
          ctx.fillStyle = "#4b5563";
          const descLines = getLines(ctx, description, contentWidth - 16 * scale).slice(0, 6);
          descLines.forEach((line) => {
            ctx.fillText(line, padding + 16 * scale, drawY);
            drawY += 28 * scale;
          });
          drawY += 8 * scale;
        } else {
          drawY += 16 * scale;
        }

        drawY += 32 * scale + extraVerticalSpace;
        ctx.beginPath();
        ctx.strokeStyle = "#f3f4f6";
        ctx.lineWidth = 1 * scale;
        ctx.moveTo(padding, drawY);
        ctx.lineTo(width - padding, drawY);
        ctx.stroke();
        drawY += 26 * scale;

        const footerY = drawY;
        if (avatarImg) {
          ctx.save();
          const avatarSize = 64 * scale;
          const avatarX = padding;
          ctx.beginPath();
          ctx.arc(avatarX + avatarSize / 2, footerY + avatarSize / 2, avatarSize / 2, 0, Math.PI * 2);
          ctx.closePath();
          ctx.clip();
          ctx.drawImage(avatarImg, avatarX, footerY, avatarSize, avatarSize);
          ctx.restore();
          ctx.beginPath();
          ctx.arc(avatarX + (64 * scale) / 2, footerY + (64 * scale) / 2, (64 * scale) / 2, 0, Math.PI * 2);
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 2 * scale;
          ctx.stroke();
        }

        const authorTextX = padding + (avatar ? 64 * scale + 16 * scale : 0);
        const textCenterY = footerY + 32 * scale;
        ctx.fillStyle = "#9ca3af";
        ctx.font = `${12 * scale}px 'Roboto', sans-serif`;
        ctx.fillText(authorText, authorTextX, textCenterY - 20 * scale);
        ctx.fillStyle = "#1f2937";
        ctx.font = `700 ${20 * scale}px 'Roboto', sans-serif`;
        ctx.fillText(author, authorTextX, textCenterY + 4 * scale);

        const qrSize = 64 * scale;
        const qrX = width - padding - qrSize;
        ctx.fillStyle = "#ffffff";
        ctx.shadowColor = "rgba(0, 0, 0, 0.05)";
        ctx.shadowBlur = 4 * scale;
        ctx.shadowOffsetY = 2 * scale;
        drawRoundedRect(ctx, qrX, footerY, qrSize, qrSize, 4 * scale);
        ctx.fill();
        ctx.shadowColor = "transparent";
        ctx.fillStyle = state.themeColor;
        ctx.font = `700 ${14 * scale}px 'Roboto', sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("分享", qrX + qrSize / 2, footerY + qrSize / 2 - 8 * scale);
        ctx.font = `${10 * scale}px 'Roboto', sans-serif`;
        ctx.fillStyle = "#6b7280";
        ctx.fillText("复制链接", qrX + qrSize / 2, footerY + qrSize / 2 + 10 * scale);

        const siteInfoX = qrX - 16 * scale;
        ctx.textAlign = "right";
        ctx.fillStyle = "#9ca3af";
        ctx.font = `${12 * scale}px 'Roboto', sans-serif`;
        ctx.fillText(scanToReadText, siteInfoX, textCenterY - 20 * scale);
        ctx.fillStyle = "#1f2937";
        ctx.font = `700 ${20 * scale}px 'Roboto', sans-serif`;
        ctx.fillText(siteTitle, siteInfoX, textCenterY + 4 * scale);

        state.posterImage = canvas.toDataURL("image/png");
        state.generating = false;
        renderModal();
      } catch (error) {
        console.error("Failed to generate poster:", error);
        state.generating = false;
        renderModal();
      }
    }

    trigger.addEventListener("click", generatePoster);
  })();
</script>
