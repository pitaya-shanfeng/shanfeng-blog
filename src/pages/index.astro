---
import HomeHero from "@/components/pages/HomeHero.astro";
import HomeBands from "@/components/pages/HomeBands.astro";
import HomeLanding from "@/components/pages/HomeLanding.astro";
import HomeSections from "@/components/pages/HomeSections.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

/**
 * 首页（2026-11-12 设计稿）
 *
 * Hero 在正文流里，不再走 customHero / 壁纸 banner；
 * 壁纸隐藏与内容偏移见 home-landing.css。
 */
---

<MainGridLayout title={siteConfig.title} heading={siteConfig.title}>
  <HomeHero />
  <HomeLanding />
  <HomeBands />
  <HomeSections />
</MainGridLayout>
