---
import HomeHero from "@/components/pages/HomeHero.astro";
import HomeLanding from "@/components/pages/HomeLanding.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

/**
 * 首页 = 通栏刊头 + 门户内容
 *
 * 刊头与合集页同一套（.book-hero）：整幅出血照片 + 压暗 + 白字 + 右下金句，
 * 所以用 customHero 走 #hero 插槽，页面自带整幅 hero。
 */
---

<MainGridLayout
  title={siteConfig.title}
  heading={siteConfig.title}
  customHero
>
  <Fragment slot="hero">
    <HomeHero />
  </Fragment>
  <HomeLanding />
</MainGridLayout>
