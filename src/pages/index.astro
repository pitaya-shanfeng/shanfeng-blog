---
import HomeHero from "@/components/pages/HomeHero.astro";
import HomeBands from "@/components/pages/HomeBands.astro";
import HomeSections from "@/components/pages/HomeSections.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

/**
 * 首页
 *
 * 刊头沿用「通栏照片 banner」（customHero + #hero 插槽）；
 * banner 之下：两本书 → 思路 / 调研 / 案例 / 笔记。
 */
---

<MainGridLayout
  title={siteConfig.title}
  heading={siteConfig.title}
  customHero
>
  <Fragment slot="hero">
    <HomeHero />
  </Fragment>
  <HomeBands />
  <HomeSections />
</MainGridLayout>
