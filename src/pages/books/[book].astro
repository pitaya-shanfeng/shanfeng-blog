---
import "@/styles/book-list-covers.css";
/**
 * 书籍落地页：/books/<book>/
 *
 * 版式（稿 A「书卷」+ v12 修订）：
 * - banner 只当壁纸，书名在书卷里（hideBannerTitle）—— 一页只说一次书名
 * - 主列 = hub page 的目录：书卷 → 序 → 五篇 → 后记 → 收尾，24 条按完整阅读顺序排
 * - 章节卡用母版原生 PostCard（list 模式），书页变体由本页 CSS 覆盖：
 *   固定高 190px、描述一行、隐藏底部标签（详见 .book-list 的样式）
 * - 左栏是母版的 profile + 音乐 + 本书阅读进度尺（components/widget/BookProgress.astro）
 *
 * 篇首语不单独成页：从 `spec` 集合取正文，在本页内折叠展开。
 * 展开用「隐藏 checkbox + label」的纯 CSS 方案，不用 JS ——
 * 站内跳转（swup）后内联脚本不会重新执行，纯 CSS 才能保证一直可用。
 */
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import SharePoster from "@/components/misc/SharePoster.svelte";
import SponsorModal from "@/components/misc/SponsorModal.astro";
import { booksConfig, siteConfig } from "@/config";
import { profileConfig } from "@/config/profileConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import PostCard from "@/components/layout/PostCard.astro";
import { bannerQuotes } from "@/utils/banner-quotes-data";
import { getSeriesPostsOf } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

export async function getStaticPaths() {
	return booksConfig.map((book) => ({
		params: { book: book.id },
		props: { book },
	}));
}

const { book } = Astro.props;

const posts = await getSeriesPostsOf(book.title);

/**
 * 排版封面上的书名取「：」之前的部分。
 * 竖排封面只有 200×267，带副书名的长标题折成两列后
 * 阅读顺序会被标点打乱；短主标题竖排才清爽，全名由右侧 h1 承担。
 */
const coverTitle = book.title.split(/[:：]/)[0].trim() || book.title;

// 支持区块：分享的是「这本书的合集页」，不是某一章
const showShare = siteConfig.post.share !== false;
const showSponsorButton = sponsorConfig.showButtonInPost;
/**
 * 海报标题取完整书名。
 * 原来拼 `${title}：${kicker}` 会重复——kicker 有时就是副书名的一部分
 * （书名里已经含「增长方法论」，再加一次 = 出现两遍）。
 */
const bookShareTitle = book.fullTitle || book.title;
/**
 * 分享海报上的日期：取这本书的发布月份，而不是分享当天。
 * 海报上的日期是「这本书何时面世」的版面信息（参考出版物内页），
 * 用当天的日期会随着每次分享变化，失去这个含义。
 * 书没有单独的出版字段，取全书最早一篇文章的 published。
 */
const bookShareDate = (() => {
	// published 是 Date 对象（zod 转过），要先 toISOString 才能截出 YYYY-MM-DD；
	// 直接 String(date) 会得到 "Thu Jan 01 1970…"，被下面的正则全部过滤掉。
	const iso = (v: unknown): string => {
		if (v instanceof Date && !Number.isNaN(v.getTime())) {
			return v.toISOString().slice(0, 10);
		}
		return String(v ?? "").slice(0, 10);
	};
	const dates = posts
		.map((p) => iso(p.data.published))
		.filter((d) => /^\d{4}-\d{2}-\d{2}$/.test(d))
		.sort();
	const earliest = dates[0];
	// 1970 是占位数据（《见山》24 篇都是），宁可不显示日期，也不印一个错的年份
	if (!earliest || earliest < "2020-01-01") return "";
	return earliest;
})();
const byOrder = new Map(posts.map((post) => [post.data.seriesOrder ?? 0, post]));

/**
 * 全书篇幅与时长：直接取母版 remark 算出的 words / minutes。
 *
 * 关键：**口径必须和每张卡片上显示的字数一致**。
 * 之前用「纯汉字」自己数（214,871），而卡片显示的是 remark 渲染后的含标点字数
 * （第 1 章 15610 vs 汉字 15485）→ 两边对不上，"读完约 X 小时"也跟着偏。
 * 用母版自己的值，加总即得全书口径。
 */
let totalWords = 0;
let totalMinutes = 0;
for (const post of posts) {
	const { remarkPluginFrontmatter } = await render(post);
	totalWords += remarkPluginFrontmatter.words ?? 0;
	totalMinutes += remarkPluginFrontmatter.minutes ?? 0;
}
const totalWan = (totalWords / 10000).toFixed(1);
const totalHours = Math.max(1, Math.round(totalMinutes / 60));

/** 全书章节数（只数「第 N 章」，附表不计） */
const chapterCount = book.parts.reduce(
	(sum, part) =>
		sum + part.entries.filter((entry) => entry.label.includes("章")).length,
	0,
);

/** 篇首语：取 spec 条目、渲染 */
const intros = new Map<string, { Content: any }>();
for (const part of book.parts) {
	// 还没写篇首语的书（introId 为空串）直接跳过：
	// getEntry 不接受空标识，会抛 UnknownContentCollectionError
	if (!part.introId) continue;
	const entry = await getEntry("spec", part.introId);
	if (!entry) continue;
	const rendered = await render(entry);
	intros.set(part.introId, { Content: rendered.Content });
}

const prefacePost = book.preface ? byOrder.get(book.preface.order) : undefined;
const afterwordPost = book.afterword ? byOrder.get(book.afterword.order) : undefined;

/**
 * 章节清单：序 → 五篇（含附表）→ 后记。
 * 供侧栏进度尺使用（滚动高亮 + 阅读进度），写在页面内的隐藏节点上。
 */
const chapterList = [
	...(prefacePost
		? [{ anchor: `ch-${prefacePost.id}`, title: prefacePost.data.title }]
		: []),
	...book.parts.flatMap((part) =>
		part.entries
			.map((entry) => {
				const post = byOrder.get(entry.order);
				if (!post) return null;
				return { anchor: `ch-${post.id}`, title: post.data.title };
			})
			.filter((x): x is { anchor: string; title: string } => x !== null),
	),
	...(afterwordPost
		? [{ anchor: `ch-${afterwordPost.id}`, title: afterwordPost.data.title }]
		: []),
].map((item, i) => ({ ...item, index: i + 1 }));

/** 章节序号（1 起），供进度尺显示「第 N 条」 */
const indexOf = (anchor: string) =>
	chapterList.find((c) => c.anchor === anchor)?.index ?? 0;

/* ---------- 刊头（hero）用到的几个值 ---------- */


/** 副书名：完整书名里「·」之后的部分（见山 · 产品判断力 → 产品判断力） */
const heroSubtitle = (() => {
	const full = book.fullTitle || book.title;
	const parts = full
		.split(/[·:：]/)
		.map((part) => part.trim())
		.filter(Boolean);
	return parts.length > 1 ? parts.slice(1).join(" · ") : "";
})();

/**
 * 刊头金句：与拾遗、行业动态等合集页共用同一份金句集
 * （src/data/banner-quotes.md，构建期解析成 bannerQuotes）。
 * 每次进页面由全局脚本抽一条、打字机打出来。
 */
const heroQuotes = bannerQuotes;

/**
 * 刊头那颗主按钮：有序言进序，没有序言直接进第 1 章（文案同步换掉）。
 * 都没有（空书）才退回目录卡。
 */
const firstChapterPost = book.parts
	.flatMap((part) => part.entries)
	.map((entry) => byOrder.get(entry.order))
	.find((post) => Boolean(post));

const readingStartUrl = prefacePost
	? getPostUrlBySlug(prefacePost.id)
	: firstChapterPost
		? getPostUrlBySlug(firstChapterPost.id)
		: "#book-toc";

const readingStartLabel = prefacePost ? "从序言开始" : "从第 1 章开始";
---

<MainGridLayout
  title={book.title}
  description={book.description}
  postBanner={book.banner}
  hideBannerTitle
  customHero
>
  {/* 横幅即书页刊头：照片当底，书名 / 定位 / 简介 / 盘口直接压在上面，
      不再另起一张白卡（见 design/shanfeng-ui/baseline/books-jianshan.html） */}
  <Fragment slot="hero">
    {/* 关键尺寸写成内联样式：跟着页面 HTML 一起被 swup 插入，
        不会因为样式表加载先后 / 切页被覆盖而失效 */}
    <header
      class="book-hero"
      style="min-height: var(--book-banner-h, max(50vh, 430px))"
    >
      {/* 窄屏模板会把非首页壁纸整块隐藏，所以照片这一份留给窄屏自己带；
          桌面端由模板 banner 提供（隐藏掉这里的副本） */}
      {
        book.banner && (
          <div class="book-hero-media" aria-hidden="true">
            <img src={book.banner} alt="" loading="eager" fetchpriority="high" />
          </div>
        )
      }
      <div class="book-hero-inner">
        {/* 书名分两层：主名大字，副书名跟在后面一行，避免 h1 一长串 */}
        <h1 class="book-hero-title">{book.title}</h1>
        {
          heroSubtitle && (
            /* 样式写在内联属性上：swup 切页后即便样式表状态不一致，这一块也不变样 */
            <p
              class="book-hero-subtitle"
              style="display: flex; align-items: center; gap: 0.75rem; margin: 0.85rem 0 0; font-size: var(--fs-ui); font-weight: 500; letter-spacing: var(--ls-wide); color: #b9d4c9;"
            >
              <span
                aria-hidden="true"
                style="flex: 0 0 auto; width: 1.6rem; height: 1px; background: var(--primary)"
              />
              {heroSubtitle}
            </p>
          )
        }
        <p class="book-hero-lead">{book.lead}</p>

        <div class="book-hero-actions">

          <a class="book-hero-cta" href={readingStartUrl}>
            {readingStartLabel}
            <Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
          </a>
          {
            showShare && (
              <SharePoster
                client:load
                title={bookShareTitle}
                author={profileConfig.name}
                description={book.description}
                pubDate={bookShareDate}
                coverImage={book.cover ?? null}
                coverFocus={book.posterFocus ?? 0.72}
                coverTitle={book.title}
                coverSubtitle={book.kicker}
                coverQuote={book.lead}
                url={Astro.url.href}
                siteTitle={siteConfig.title}
                avatar={profileConfig.avatar ?? null}
                avatarSelector=".profile-avatar-image img"
              />
            )
          }
          {
            showSponsorButton && (
              <button type="button" data-sponsor-open class="book-hero-ghost">
                {i18n(I18nKey.sponsor)}
                <Icon name="material-symbols:favorite-rounded" class="text-sm" />
              </button>
            )
          }
        </div>
      </div>

      {
        heroQuotes.length > 0 && (
          /* 外框只为对齐导航栏：宽度/内边距和 #top-row 同一套算法，
             金句右边缘才会正好落在导航胶囊的右边上。
             data-quote-host 告诉全局脚本：这次把打字机层挂在这里。 */
          <div
            class="book-hero-quote-wrap"
            data-quote-host
            aria-hidden="true"
          />
        )
      }

    </header>
  </Fragment>

  <div
    class="book-page onload-animation"
    data-book-id={book.id}
    data-no-category-bar
    data-quotes={heroQuotes.length ? JSON.stringify(heroQuotes) : undefined}
  >
    <!-- 章节元数据：供侧栏进度尺读取 -->
    <script
      type="application/json"
      data-book-chapters
      is:inline
      set:html={JSON.stringify(chapterList)}
      style="display:none"
    />

    <!-- 关于这本书：封面 + 一句引文 + 简介 + 盘口。
         这几段原来浮在 banner 上，压着照片不好读，统一收进这张卡 -->
    <section class="book-about card-base" id="book-toc">
      <div class="book-about-cover">
        {
          book.cover ? (
            <img src={book.cover} alt={`${book.title}封面`} loading="eager" />
          ) : (
            <div class="plate" aria-hidden="true">
              <span
                class="cv-title"
                style={[
                    coverTitle.length > 6 ? "font-size: 1.25rem" : "",
                  ]
                    .filter(Boolean)
                    .join("; ") || undefined}
              >
                {coverTitle}
              </span>
              <span class="cv-bottom">山风 著</span>
            </div>
          )
        }
      </div>
      <div class="book-about-text">
        <p class="book-about-name">{book.fullTitle || book.title}</p>
        <p class="book-about-author">{profileConfig.name}</p>
        <p class="book-about-desc">{book.description}</p>
        <ul class="book-about-facts">
          <li><b>{book.parts.length}</b> 篇</li>
          <li><b>{chapterCount}</b> 章</li>
          {
            (book.preface || book.afterword) && (
              <li>
                {book.preface && book.afterword
                  ? "序与后记"
                  : book.preface
                    ? "序"
                    : "后记"}
              </li>
            )
          }
          <li>约 <b>{totalWan}</b> 万字</li>
          <li>读完约 <b>{totalHours}</b> 小时</li>
        </ul>

      </div>
    </section>

    <!-- 序 -->
    {
      prefacePost && (
        <section class="book-part">
          <div class="book-list list-mode">
            <div
              class="book-item"
              data-book-chapter={`ch-${prefacePost.id}`}
              data-book-index={indexOf(`ch-${prefacePost.id}`)}
              data-book-title={prefacePost.data.title}
            >
              <PostCard
                entry={prefacePost}
                title={prefacePost.data.title}
                tags={prefacePost.data.tags}
                category={prefacePost.data.category}
                published={prefacePost.data.published}
                updated={prefacePost.data.updated}
                url={getPostUrlBySlug(prefacePost.id)}
                image={prefacePost.data.image}
                description={prefacePost.data.description}
                draft={prefacePost.data.draft}
                pinned={prefacePost.data.pinned}
                password={!!prefacePost.data.password}
                categoryInBottom
                metaOverride={{ words: true, readingTime: true }}
                loading="eager"
              />
            </div>
          </div>
        </section>
      )
    }

    <!-- 五篇 -->
    {
      book.parts.map((part, index) => {
        const intro = intros.get(part.introId);
        const checkId = `pi-${book.id}-${index}`;
        return (
          <section class="book-part">
            <div class="group-panel card-base">
              <div class="group-head">
                <span class="gno">{part.name}</span>
                <h2>{part.title}</h2>
              </div>

              {intro && (
                <div class="gintro">
                  <h3 class="gintro-lead">{part.subtitle}</h3>
                  <div class="pi-body">
                    <intro.Content />
                  </div>
                </div>
              )}
            </div>

            <div class="book-list list-mode">
              {part.entries.map((entry) => {
                const post = byOrder.get(entry.order);
                if (!post) return null;
                const anchor = `ch-${post.id}`;
                // 「附」不是独立一章：作为上一篇的附属，用无封面卡片形态
                const isAppendix = entry.label.includes("附");
                const cardTitle = post.data.title;
                return (
                  <div
                    class="book-item"
                    data-book-chapter={anchor}
                    data-book-index={indexOf(anchor)}
                    data-book-title={post.data.title}
                  >
                    <PostCard
                      entry={post}
                      title={cardTitle}
                      tags={post.data.tags}
                      category={post.data.category}
                      published={post.data.published}
                      updated={post.data.updated}
                      url={getPostUrlBySlug(post.id)}
                      image={isAppendix ? "" : post.data.image}
                      description={post.data.description}
                      draft={post.data.draft}
                      pinned={post.data.pinned}
                      password={!!post.data.password}
                      categoryInBottom
                      metaOverride={{ words: true, readingTime: true }}
                metaOverride={{ words: true, readingTime: true }}
                      loading="lazy"
                    />
                  </div>
                );
              })}
            </div>
          </section>
        );
      })
    }

    <!-- 后记 -->
    {
      afterwordPost && (
        <section class="book-part">
          <div class="book-list list-mode">
            <div
              class="book-item"
              data-book-chapter={`ch-${afterwordPost.id}`}
              data-book-index={indexOf(`ch-${afterwordPost.id}`)}
              data-book-title={afterwordPost.data.title}
            >
              <PostCard
                entry={afterwordPost}
                title={afterwordPost.data.title}
                tags={afterwordPost.data.tags}
                category={afterwordPost.data.category}
                published={afterwordPost.data.published}
                updated={afterwordPost.data.updated}
                url={getPostUrlBySlug(afterwordPost.id)}
                image={afterwordPost.data.image}
                description={afterwordPost.data.description}
                draft={afterwordPost.data.draft}
                pinned={afterwordPost.data.pinned}
                password={!!afterwordPost.data.password}
                categoryInBottom
                metaOverride={{ words: true, readingTime: true }}
                loading="lazy"
              />
            </div>
          </div>
        </section>
      )
    }
  </div>
  {showSponsorButton && <SponsorModal />}
</MainGridLayout>

