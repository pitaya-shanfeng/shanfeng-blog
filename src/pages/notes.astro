---
/**
 * 学习笔记合集页：/notes/
 *
 * 对象是「自己的理解过程」：不总结别人的书，只记这个知识点怎么啃下来的。
 * 版式与取数在 src/components/collection/CollectionPage.astro。
 */

import CollectionPage from "@/components/collection/CollectionPage.astro";
import { bannerQuotes } from "@/utils/banner-quotes-data";

const LEAD = "把「学会了」拆成能回看的每一步。";
const DESC =
	"学的时候记，不等到学会再写——所以会有卡住的地方、试错的做法、被推翻的判断。每条只回答三件事：它到底是什么，我在什么场景下用过，它替我省下了什么。不整理成知识图谱，也不假装成体系。";
const EMPTY_HINT =
	"第一篇大概会从一个具体的卡点开始——哪个概念没想通、试了什么、后来怎么绕过去的。";
---

<CollectionPage
	path="/notes/"
	category="学习笔记"
	lead={LEAD}
	desc={DESC}
	banner="/assets/images/notes-banner.webp"
	quotes={bannerQuotes}
	emptyHint={EMPTY_HINT}
	icon="material-symbols:edit-note-rounded"
	unit="篇"
/>
