---
import type { MarkdownHeading } from "astro";
import { render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { readdirSync } from "node:fs";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import "@/styles/banner-post.css";
import {
	getRelatedPosts,
	getSeriesPosts,
	getAllPostsForRoutes,
} from "@utils/content-utils";
import { extractPostQuote } from "@utils/post-quote-utils";
import { getBannerVisibilityState } from "@utils/banner-visibility-utils";
import { HTML_POST_CONTENT_CLASS } from "@utils/html-post-utils";
import {
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import EmbedReader from "@/components/misc/EmbedReader.astro";
import ReportBrief from "@/components/misc/ReportBrief.astro";
import SeriesNav from "@/components/misc/SeriesNav.astro";
import SharePoster from "@/components/misc/SharePoster.svelte";
import SponsorModal from "@/components/misc/SponsorModal.astro";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { bannerForCategory } from "@/config/sectionBanners";
import pdfTocs from "@/constants/pdf-tocs.json";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import {
	getAuthorAvatarUrl,
	getSiteLogo,
	toAbsoluteImageInfo,
} from "@/utils/schema-image";
import {
	buildBreadcrumbList,
	buildPersonEntity,
	buildPublisherEntity,
	toAbsoluteUrl,
} from "@/utils/schema-utils";
import { url } from "@/utils/url-utils";

// 打赏入口：独立打赏页已下线，改由文章内弹窗承载，
// 因此只看「文章内显示打赏按钮」开关，不再依赖 siteConfig.pages.sponsor
const showSponsorButton = sponsorConfig.showButtonInPost;
const showPostActionCard = siteConfig.post.share || showSponsorButton;

export async function getStaticPaths() {
	const blogEntries = await getAllPostsForRoutes();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings: rawHeadings } = await render(entry);

/**
 * 目录用的标题列表：排除脚注区。
 * markdown 的脚注会被渲染成一个 `<h2>Footnotes</h2>` + 引用列表，
 * Astro 的 headings 把它一起收进来，于是「Footnotes」会当成第 7 章出现在目录里。
 * 它不是正文章节，不该出现在导航里。
 */
const headings = rawHeadings.filter((h) => {
	const text = (h.text || "").trim();
	const slug = h.slug || "";
	if (/^footnotes?$/i.test(text)) return false;
	if (/footnote/i.test(slug)) return false;
	return true;
});

/**
 * 文档流文章（PDF 按页转 webp 内嵌）正文没有标题，侧栏目录会是空的。
 * 这类文章的目录由 scripts/gen_pdf_toc.py 从 PDF 字体层级提取，按 slug 登记在
 * constants/pdf-tocs.json；这里只做兜底，正常 md 文章的目录不受影响。
 * 页图锚点（id / data-toc-heading / data-subtitles）由 remark-document-page-anchors
 * 在编译期打上，两端同源。
 */
if (headings.length === 0) {
	const pdfToc = (pdfTocs as Record<string, MarkdownHeading[]>)[entry.id];
	if (pdfToc?.length) {
		headings.push(...pdfToc);
	}
}

const { remarkPluginFrontmatter } = await render(entry);

// HTML 文章（.html）与 md 文章共用本页；区别只有一处：
// HTML 文章要把正文容器加上作用域类，给 loader 里做好的自带样式做锚点
const isHtmlPost = entry.data.format === "html";
const markdownClass = `mb-6 markdown-content onload-animation${
	isHtmlPost ? ` ${HTML_POST_CONTENT_CLASS}` : ""
}`;

// banner 金句：优先从正文第一个引用块自动提取，没有引用块则回退到 frontmatter 的 description。
// 注意：SEO / 分享卡片仍使用 entry.data.description，不受此处影响。
// 优先级：frontmatter 的 quote（人工提炼的金句）> 正文首个引用块 > description
const bannerQuote =
	entry.data.quote || extractPostQuote(entry.body) || entry.data.description;

// 字数 / 阅读时长：md 文章来自 remark 插件，HTML 文章由 loader 直接写进 data。
// ⚠️ `rendered.metadata` 不会变成 `remarkPluginFrontmatter`，所以 HTML 文章必须读 data ——
// 本页有两处要用（banner 与移动端正文顶部），统一在这里取好，别再各写各的。
const postWords = entry.data.words ?? remarkPluginFrontmatter.words;
const postMinutes = entry.data.minutes ?? remarkPluginFrontmatter.minutes;

/**
 * 原型类文章的字数没有意义（正文只有一个 iframe），改成报「页数」：
 * 从镜像目录 public/proto/<dir>/ 里数页面 HTML 得出，不用手填。
 */
const prototypeDir = (entry.data as { prototypeDir?: string }).prototypeDir ?? "";
const prototypePages = (() => {
	if (!prototypeDir) return 0;
	try {
		const dir = `public/proto/${prototypeDir}`;
		return readdirSync(dir)
			.filter((f) => f.endsWith(".html"))
			.filter((f) => !/^(index|entry|start)/.test(f)).length;
	} catch {
		return 0;
	}
})();

const bannerPostMeta = {
	title: entry.data.title,
	description: bannerQuote,
	published: entry.data.published,
	updated: entry.data.updated,
	words: prototypePages ? undefined : postWords,
	pages: prototypePages || undefined,
	// 原型文章不报阅读时长：它是拿来点的，不是拿来读的
	minutes: prototypePages ? undefined : postMinutes,
	category: entry.data.category || undefined,
	series: (entry.data as { series?: string }).series || undefined,
	tags: entry.data.tags,
};

// 桌面端 banner 已经展示「标题 + 元信息」→ 正文不再重复（移动端没有 banner，仍保留）
const bannerState = getBannerVisibilityState({
	isHomePage: false,
	isPostPage: true,
	title: entry.data.title,
	bannerPostMeta,
});
const hideMetaInBody = bannerState.showBannerPostMeta;

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);
const showPostCover = Boolean(processedImage && coverImageConfig.enableInPost);
const usePostCoverOverlay =
	showPostCover && (coverImageConfig.enableInPostOverlay ?? true);

const getDirectImageUrl = (src: string | undefined): string | null => {
	if (!src) return null;
	if (
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("//") ||
		src.startsWith("data:")
	) {
		return src;
	}
	return src.startsWith("/") ? url(src) : null;
};

// 海报优先复用页面上已经优化过的图片，本地源路径不再单独导入。
const posterCoverUrl = showPostCover ? null : getDirectImageUrl(processedImage);
const posterCoverSelector = showPostCover ? "#post-cover img" : null;
const posterAvatarUrl = getDirectImageUrl(profileConfig.avatar);
const posterAvatarSelector = profileConfig.avatar
	? ".profile-avatar-image img"
	: null;

dayjs.extend(utc);

const coverBasePath = getFileDirFromPath(entry.filePath || "");
const coverImage =
	(await toAbsoluteImageInfo(
		processedImage,
		coverBasePath,
		siteConfig.site_url,
	)) ?? undefined;

// 作者个人页（/about/）绝对 URL，用于 author.url 指向唯一标识作者的页面
const aboutUrl =
	toAbsoluteUrl("/about/", siteConfig.site_url) ?? siteConfig.site_url;

// 作者实体：与首页/about 的 Person 共用同一 @id（#person），author 用 @id 关联
const authorAvatarUrl = await getAuthorAvatarUrl();
const authorPerson = buildPersonEntity({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: aboutUrl,
	avatarUrl: authorAvatarUrl,
	description: profileConfig.bio,
});

// publisher 实体（Organization，含真实 logo），article 的 publisher 用其 @id 关联
const publisher = buildPublisherEntity({
	site: siteConfig.site_url,
	siteConfig,
	logo: await getSiteLogo(),
});

const breadcrumbItems = [
	{
		name: i18n(I18nKey.home),
		url: toAbsoluteUrl("/", siteConfig.site_url) ?? siteConfig.site_url,
	},
];
if (entry.data.category) {
	breadcrumbItems.push({
		name: entry.data.category,
		url:
			toAbsoluteUrl(getCategoryUrl(entry.data.category), siteConfig.site_url) ??
			siteConfig.site_url,
	});
}
breadcrumbItems.push({ name: entry.data.title, url: Astro.url.toString() });

const breadcrumbList = buildBreadcrumbList(breadcrumbItems);

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BlogPosting",
			headline: entry.data.title,
			description: entry.data.description || entry.data.title,
			keywords: entry.data.tags.length ? entry.data.tags.join(", ") : undefined,
			author: { "@id": authorPerson["@id"] },
			publisher: { "@id": publisher["@id"] },
			...(coverImage
				? {
						image: {
							"@type": "ImageObject",
							url: coverImage.url,
							contentUrl: coverImage.url,
							...(coverImage.width ? { width: coverImage.width } : {}),
							...(coverImage.height ? { height: coverImage.height } : {}),
						},
					}
				: {}), // 优化：有封面才输出，避免 image:null
			datePublished: entry.data.published.toISOString(),
			...(entry.data.category ? { articleSection: entry.data.category } : {}),
			...(postWords
				? { wordCount: postWords }
				: {}),
			...(entry.data.updated
				? { dateModified: entry.data.updated.toISOString() }
				: {}),
			mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.toString() },
			url: Astro.url.toString(),
			inLanguage: entry.data.lang
				? entry.data.lang.replace("_", "-")
				: siteConfig.lang.replace("_", "-"),
		},
		authorPerson,
		publisher,
		breadcrumbList,
	],
};

// 相关文章：由文章页统一计算，供左侧栏「相关文章」组件展示（上限 10 篇）
const relatedPosts = await getRelatedPosts(entry, 10);

/**
 * 海报上的日期：1970 是占位数据（《见山》24 篇 published 都是 1970-01-01），
 * 印在分享图上会变成「1970.01」。宁可空着，也不印一个错的年份。
 */
const posterDate =
	entry.data.published.getFullYear() < 2020
		? ""
		: formatDateToYYYYMMDD(entry.data.published);
const seriesData = await getSeriesPosts(entry);

/**
 * 详情页顶部 banner：frontmatter 的 banner 优先，没写就按分类取栏目兜底图。
 * 不加这一层的话，栏目文章只要漏写一篇，那篇就回落到全局壁纸，
 * 夹在同类文章中间明显是断的。
 * 分类按 `/` 拆段匹配，所以 `拾遗/学习笔记` 这种路径式写法同样命中。
 */
const postBanner =
	(entry.data as { banner?: string }).banner ||
	bannerForCategory(entry.data.category) ||
	undefined;
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCoverImage={coverImage?.url}
  postCategory={entry.data.category || undefined}
  ogImageWidth={coverImage?.width}
  ogImageHeight={coverImage?.height}
  ogImageAlt={entry.data.title}
  headings={headings}
  encrypted={!!entry.data.password}
  bannerPostMeta={bannerPostMeta}
  postBanner={postBanner}
  relatedPostList={relatedPosts}
>
    <!--
      导航栏的当前栏判定要用到这个（客户端脚本读它）：
      文章属于哪本书（series）与带哪些标签。放在 swup 容器内，
      换页后客户端能读到新页面的值。
    -->
    {/* 原型/全宽文章：在 swup 容器内打标记，由 layout-base.css 用 :has 收掉左栏。
        不能用布局的 hideSidebar 属性 —— #main-grid 是 swup 的静态元素，
        按某一页写死之后，站内切到别的页面不会恢复。 */}
    {entry.data.hideSidebar === true && <div hidden data-fullwidth-post></div>}

    <div
      hidden
      data-nav-post
      data-series={(entry.data as { series?: string }).series ?? ""}
      data-tags={(entry.data.tags ?? []).join(",")}
    ></div>

  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />

  <!-- og:article 结构化元数据 -->
  <meta slot="head" property="article:published_time" content={entry.data.published.toISOString()} />
  {entry.data.updated && (
    <meta slot="head" property="article:modified_time" content={entry.data.updated.toISOString()} />
  )}
  <meta slot="head" property="article:author" content={entry.data.author || profileConfig.name} />
  {entry.data.category && (
    <meta slot="head" property="article:section" content={entry.data.category} />
  )}
  {entry.data.tags.map((tag) => (
    <meta slot="head" property="article:tag" content={tag.trim()} />
  ))}
  {/* 加密/密码保护文章：内容不可被爬取，标注 noindex, noarchive */}
  {entry.data.password && (
    <meta slot="head" name="robots" content="noindex, noarchive" />
  )}

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  {/* data-post-page：供客户端判断当前是否为文章详情页（分类栏在文章页隐藏）。
      data-post-id：供侧栏「相关文章」在站内跳转后识别当前文章、重建列表。
      data-post-category：侧栏是 swup 静态容器，切页不重渲染，所以当前文章的分类
      必须由这层（在 swup 容器内、每次替换）给出，相关文章才能判断该不该显形。
      id="post-card-wrapper"：沉浸阅读模式用它锁定「只留文章卡片」。 */}
  <div
    id="post-card-wrapper"
    data-post-page="true"
    data-post-id={entry.id}
    data-post-category={entry.data.category || ""}
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      {
        usePostCoverOverlay && processedImage && (
          <div class="-mx-6 md:-mx-9 -mt-6 mb-6 h-48 md:h-64 relative onload-animation">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              alt={entry.data.title}
              class="h-full"
              preview={false}
              apiUrls={apiUrls}
            />
            <div class="absolute inset-x-4 top-3 z-10 flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-xs font-medium text-white drop-shadow-[0_1px_2px_rgb(0_0_0/0.9)]">
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon
                  name={prototypePages ? "material-symbols:layers-outline-rounded" : "material-symbols:notes-rounded"}
                  class="text-base"
                />
                <span>
                  {prototypePages ? `${prototypePages} 页原型` : `${postWords} ${i18n(postWords === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}`}
                </span>
              </div>
              {!prototypePages && (
                <div class="flex items-center gap-1 whitespace-nowrap">
                  <Icon name="material-symbols:schedule-outline-rounded" class="text-base" />
                  <span>
                    {postMinutes}
                    {" " + i18n(postMinutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                  </span>
                </div>
              )}
              {entry.data.password && (
                <div class="flex items-center gap-1 whitespace-nowrap">
                  <Icon name="material-symbols:lock-outline" class="text-base" />
                  <span>{i18n(I18nKey.postEncrypted)}</span>
                </div>
              )}
            </div>
            <div class="absolute inset-x-0 bottom-0 px-6 md:px-9 pt-10 pb-3 bg-gradient-to-t from-black/80 via-black/45 to-transparent">
              <div
                data-pagefind-body
                data-pagefind-weight="10"
                data-pagefind-meta="title"
                class="mb-2 text-xl md:text-2xl font-bold leading-tight text-white"
              >
                {entry.data.title}
              </div>
              <PostMetadata
                variant="cover"
                className="gap-x-4 gap-y-1"
                published={entry.data.published}
                updated={entry.data.updated}
                category={entry.data.category || undefined}
                series={entry.data.series || undefined}
                tags={entry.data.tags}
                id={entry.id}
              />
            </div>
          </div>
        )
      }

      <!-- word count and reading time（桌面端 banner 已展示，正文仅移动端保留） -->
      {
        !usePostCoverOverlay && (
          <div
            class:list={[
              "flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation",
              hideMetaInBody && "lg:hidden",
            ]}
          >
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon name={prototypePages ? "material-symbols:layers-outline-rounded" : "material-symbols:notes-rounded"} />
              </div>
              <div class="text-sm">
                {prototypePages ? `${prototypePages} 页原型` : `${postWords} ${i18n(I18nKey.wordsCount)}`}
              </div>
            </div>
            {!prototypePages && (
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon name="material-symbols:schedule-outline-rounded" />
              </div>
              <div class="text-sm">
                {postMinutes}
                {
                  " " +
                    i18n(
                      postMinutes === 1
                        ? I18nKey.minuteCount
                        : I18nKey.minutesCount
                    )
                }
              </div>
            </div>
            )}
            {entry.data.password && (
              <div class="flex flex-row items-center">
                <div
                  class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                >
                  <Icon name="material-symbols:lock-outline" />
                </div>
                <div class="text-sm">
                  {i18n(I18nKey.postEncrypted)}
                </div>
              </div>
            )}
          </div>
        )
      }

      <!-- title（桌面端 banner 已展示，正文仅移动端保留） -->
      {
        !usePostCoverOverlay && (
          <div class:list={["relative onload-animation", hideMetaInBody && "lg:hidden"]}>
            <div
              data-pagefind-body
              data-pagefind-weight="10"
              data-pagefind-meta="title"
              class="transition w-full block font-bold mb-3
                        text-3xl md:text-[2.25rem]/[2.75rem]
                        text-black/90 dark:text-white/90
                        md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                        before:absolute before:top-3 before:-left-4.5"
            >
              {entry.data.title}
            </div>
          </div>
        )
      }

      <!-- metadata（桌面端 banner 已展示，正文仅移动端保留） -->
      {
        !usePostCoverOverlay && (
          <div class:list={["onload-animation", hideMetaInBody && "lg:hidden"]}>
            <PostMetadata
              className="mb-5"
              published={entry.data.published}
              updated={entry.data.updated}
              tags={entry.data.tags}
              category={entry.data.category || undefined}
              series={entry.data.series || undefined}
              id={entry.id}
            />
            {
              !showPostCover && (
                <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
              )
            }
          </div>
        )
      }

      {
        seriesData && (
          <SeriesNav
            seriesName={seriesData.seriesName}
            posts={seriesData.posts}
            currentPostId={entry.id}
          />
        )
      }

      {
        showPostCover && !usePostCoverOverlay && processedImage && (
          <div class="mt-4">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              alt={entry.data.title}
              class="mb-8 rounded-xl onload-animation"
              preview={false}
              naturalHeight
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class={markdownClass}>
            <Content />
          </Markdown>

          {/* 打赏按钮 & 分享按钮（正文末尾） */}
          {
            showPostActionCard && (
              <div data-post-action-bar class="mb-6 rounded-xl onload-animation">
                <div class="p-6 bg-(--license-block-bg) rounded-xl">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 flex-1">
                      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon
                          name={showSponsorButton ? "material-symbols:favorite" : "material-symbols:share"}
                          class="text-2xl"
                        />
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                          {showSponsorButton ? i18n(I18nKey.sponsorButton) : i18n(I18nKey.shareOnSocial)}
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                          {showSponsorButton ? i18n(I18nKey.sponsorButtonText) : i18n(I18nKey.shareOnSocialDescription)}
                        </p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      {
                        siteConfig.post.share && (
                          <SharePoster
                            client:load
                            title={entry.data.title}
                            author={entry.data.author || profileConfig.name}
                            description={entry.data.description || entry.data.title}
                            pubDate={posterDate}
                            coverImage={posterCoverUrl}
                            coverImageSelector={posterCoverSelector}
                            url={Astro.url.href}
                            siteTitle={siteConfig.title}
                            avatar={posterAvatarUrl}
                            avatarSelector={posterAvatarSelector}
                          />
                        )
                      }
                      {
                        showSponsorButton && (
                          <button
                            type="button"
                            data-sponsor-open
                            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap cursor-pointer"
                          >
                            <span>{i18n(I18nKey.sponsor)}</span>
                            <Icon name="material-symbols:favorite-rounded" class="text-sm" />
                          </button>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </EncryptedPost>
      ) : (
        <>
          {/* 转载类文章：正文之前先给「报告速览」。
              这类文章正文是页图或外站链接，读者翻完才知道讲什么，
              关键数字与「为什么收它」必须放在第一屏。 */}
          <ReportBrief report={entry.data.report} />

          <Markdown class={markdownClass}>
            <Content />
          </Markdown>

          {/* 外链型转载：正文之后挂内置阅读器，让读者不必离站 */}
          {entry.data.report?.embed && entry.data.report.href && (
            <EmbedReader
              href={entry.data.report.href}
              source={entry.data.report.source}
            />
          )}

          {/* 打赏按钮 & 分享按钮（正文末尾） */}
          {
            showPostActionCard && (
              <div data-post-action-bar class="mb-6 rounded-xl onload-animation">
                <div class="p-6 bg-(--license-block-bg) rounded-xl">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 flex-1">
                      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon
                          name={showSponsorButton ? "material-symbols:favorite" : "material-symbols:share"}
                          class="text-2xl"
                        />
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                          {showSponsorButton ? i18n(I18nKey.sponsorButton) : i18n(I18nKey.shareOnSocial)}
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                          {showSponsorButton ? i18n(I18nKey.sponsorButtonText) : i18n(I18nKey.shareOnSocialDescription)}
                        </p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      {
                        siteConfig.post.share && (
                          <SharePoster
                            client:load
                            title={entry.data.title}
                            author={entry.data.author || profileConfig.name}
                            description={entry.data.description || entry.data.title}
                            pubDate={posterDate}
                            coverImage={posterCoverUrl}
                            coverImageSelector={posterCoverSelector}
                            url={Astro.url.href}
                            siteTitle={siteConfig.title}
                            avatar={posterAvatarUrl}
                            avatarSelector={posterAvatarSelector}
                          />
                        )
                      }
                      {
                        showSponsorButton && (
                          <button
                            type="button"
                            data-sponsor-open
                            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap cursor-pointer"
                          >
                            <span>{i18n(I18nKey.sponsor)}</span>
                            <Icon name="material-symbols:favorite-rounded" class="text-sm" />
                          </button>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </>
      )}
    </div>
  </div>

  <!-- 上次编辑时间 -->
  {
    siteConfig.post.showLastModified && (() => {
      const lastModified = dayjs(entry.data.updated || entry.data.published);
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.post.outdatedThreshold ?? 1;

      // 1. 預設加上 hidden 隱藏，並把時間與閾值綁在 data-* 屬性
      return (
        <div 
          id="outdated-card" 
          class="card-base p-6 mb-4 hidden" 
          data-date={lastModified.toISOString()} 
          data-threshold={outdatedThreshold}
        >
          <div class="flex items-center gap-2">
            <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
              <Icon
                name="material-symbols:history-rounded"
                class="text-4xl text-(--primary) transition-transform group-hover:translate-x-0.5 bg-(--enter-btn-bg) p-2 rounded-md"
              />
            </div>

            <div class="flex flex-col gap-0.1">
              <div class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75">
                {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
                <span id="days-ago-text" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
              </div>
              <p id="outdated-warning" class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75 hidden">
                {i18n(I18nKey.lastModifiedOutdated)}
              </p>
            </div>
          </div>
        </div>
      );
    })()
  }

  <script>
    const card = document.getElementById('outdated-card');
    const dateStr = card?.dataset.date;

    if (card && dateStr) {
      // 讀取伺服器給的日期，用原生 Date 算出差異天數（避免向客戶端打包整個 dayjs）
      const lastModified = new Date(dateStr);
      const daysDiff = Math.floor(
        (Date.now() - lastModified.getTime()) / 86400000,
      );
      const threshold = Number(card.dataset.threshold);

      // 如果超過閾值，就顯示卡片與提示文字
      if (daysDiff >= threshold) {
        card.classList.remove('hidden');

        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }

          const warningEl = document.getElementById('outdated-warning');
          if (warningEl) {
            warningEl.classList.remove('hidden');
          }
        }
      }
    }
  </script>

  {
    siteConfig.post.postNavigation && (
      <div
        class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
      >
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")}
      class="w-full font-bold overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
        <Icon
          name="material-symbols:chevron-left-rounded"
          class="text-[2rem] text-(--primary)"
        />
        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
          {entry.data.nextTitle || i18n(I18nKey.home)}
        </div>
      </div>
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")}
      class="w-full font-bold overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
          {entry.data.prevTitle || i18n(I18nKey.home)}
        </div>
        <Icon
          name="material-symbols:chevron-right-rounded"
          class="text-[2rem] text-(--primary)"
        />
      </div>
    </a>
      </div>
    )
  }

  <!--
    相关文章区块已移到左侧栏（sidebarConfig 的 relatedPosts 组件，最多 10 篇），
    正文底部不再渲染 RecommendedPost
  -->

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}

  <!-- 打赏弹窗（由文章内「打赏」按钮打开） -->
  {showSponsorButton && <SponsorModal />}
</MainGridLayout>
