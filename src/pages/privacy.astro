---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";

// 正文来自 src/content/spec/privacy.md，与 about / guestbook 同一套做法
const entry = await getEntry("spec", "privacy");

if (!entry) {
	throw new Error("privacy page content not found");
}

const { Content } = await render(entry);

const title = "版权声明";
const description = "本站内容的授权范围与转载方式";
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
      <div class="mb-8">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:balance" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
      </div>

      <Markdown class="mt-2">
        <Content />
      </Markdown>
    </div>
  </div>
</MainGridLayout>
