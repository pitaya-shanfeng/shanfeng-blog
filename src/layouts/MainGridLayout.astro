---
import "@/styles/banner-layout.css";
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import type { PostForList } from "@/utils/content-utils";
import {
	live2dWidgetConfig,
	navbarMode,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	/** 相关文章数据，透传给侧栏的相关文章组件（侧栏不做推荐逻辑） */
	relatedPostList?: PostForList[];
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
		category?: string;
		tags?: string[];
	};
	heading?: string;
	/** 本页不要侧栏（书页这类自带整幅版式的页面） */
	hideSidebar?: boolean;
	/** banner 只当背景，不显示页面标题（书页把书名放回正文里） */
	hideBannerTitle?: boolean;
	/**
	 * 页面自带整幅 hero：跳过壁纸 banner，改由页面通过 #hero 插槽渲染
	 * （见山/增长黑客这类书页，横幅和书名、简介合成一块）
	 */
	customHero?: boolean;
	/** 文章自己的 banner 图（frontmatter 的 banner），给了就覆盖全局壁纸 */
	postBanner?: string;
}

// 文章级 banner：文章页传了 postBanner 就用它，否则回落全局壁纸
const backgroundImages = getBackgroundImages(Astro.props.postBanner);

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
	postCategory,
	headings = [],
	encrypted = false,
	relatedPostList = [],
	bannerPostMeta,
	heading,
	hideSidebar = false,
	hideBannerTitle = false,
	customHero = false,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const shouldRenderCategoryBar = !!siteConfig.categoryBar;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const banner = getBannerVisibilityState({
	isHomePage: isHomePageCheck,
	isPostPage,
	title,
	bannerPostMeta,
});
// 书页这类页面：banner 只当背景，书名由正文自己交代
if (hideBannerTitle) banner.showBannerPageTitle = false;

const sidebar = getEffectiveSidebarState({ isPostPage, hideSidebar });
// 单页隐藏侧栏时，连侧栏 DOM 也不必渲染
const sidebarEnabled = sidebarLayoutConfig.enable && !hideSidebar;

const { hasWallpaper } = banner;
const {
	hideSidebarOnPostPage,
	hasLeftComponents,
	hasRightComponents,
	sidebarClass,
	staticBarClass,
	gridColumnStyle,
	gridDataAttrs,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogImageAlt={ogImageAlt} hasWallpaper={hasWallpaper}>

<slot slot="head" name="head" />
<HeaderTopRow navbarMode={navbarMode} navbarWidthFull={navbarWidthFull} />

{/* 书页自绘的刊头。
    必须包在 swup 容器里：它在页面内容之外（层级上要压住壁纸、又要整幅出血），
    如果只是普通 slot，切页时 swup 只换 #swup-container，这块根本不会更新。
    非书页时它是一个空容器，切页时被替换成空，不会留下上一页的刊头。 */}
<div id="book-hero-container">{customHero && <slot name="hero" />}</div>

{/* 壁纸区在所有页面都渲染，书页只是用 CSS 把它藏起来（见 styles/book-page.css）。
   不能按页跳过着渲染：它整块在 swup 容器之外、跨页常驻，
   少渲染一次，切到别的页面时这块残留的 DOM 就是旧结构与旧定位。 */}
<WallpaperSection customBanner={!!Astro.props.postBanner} state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<!-- Main content -->
{/* 书页的“顶到最上面”由 styles/book-page.css 的 :has() 规则接管：
   这个节点也在 swup 容器外，不能按页加类，否则切页后类不会还原。 */}
<div id="content-panel" class="content-panel absolute w-full z-30 pointer-events-none">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div id="content-panel-inner" class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto" style={gridColumnStyle}>
        {/* 列几何唯一真源 = computeGridColumns()，SSR 写在父级 #content-panel-inner 上
            （页脚作为兄弟节点也要拿到 --content-ratio-*）。子元素无需定位类：
            侧栏包裹层是 display:contents，真正的 grid item 是内层元素 */}
        <div id="main-grid"
          class="transition duration-700 w-full left-0 right-0 grid mx-auto gap-4 px-2 md:px-4 mobile-no-sidebar"
          {...gridDataAttrs}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarEnabled}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
                relatedPostList={relatedPostList}
                postCategory={postCategory}
            />
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div id="content-column" class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染；文章详情页由「支持与分享」条替代，渲染时即隐藏（避免闪烁） */}
                {shouldRenderCategoryBar && (
                    <div
                        id="category-bar-wrapper"
                        class:list={[isPostPage && "hidden"]}
                    >
                        <CategoryBar currentPostCategory={postCategory} />
                    </div>
                )}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                {/* 为每个页面提供一个隐藏的 h1 用于 SEO 和可访问性；
                    自带 hero + 可见 h1 的页面（书页）不再重复渲染 */}
                {!customHero && <h1 class="sr-only">{heading || title}</h1>}
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>

                {/* 移动端底部组件：<768px 时 #main-grid 是 display:block，必须排在页脚之前 */}
                {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                    <div id="mobile-bottom-sidebar" class="block md:hidden mt-4">
                        <SideBar
                            side="bottom"
                            headings={headings}
                            encrypted={encrypted}
                            relatedPostList={relatedPostList}
                            postCategory={postCategory}
                        />
                    </div>
                )}
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
                relatedPostList={relatedPostList}
                postCategory={postCategory}
            />

        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}

        {/* 页脚宽度跨「侧栏 + 内容栏」，故在 #content-column 之外；又在 Swup 容器之外，
            切页不重渲染 */}
        <Footer />
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

<!-- 移动端导航抽屉：渲染为 <body> 直系子元素，脱离导航栏的 transform 包含块才能铺满视口 -->
<NavMenuPanel links={resolveNavMenuLinks()} />

<!--
    触屏设备上让代码块的复制按钮默认隐藏，点一下代码块才显形。
    expressive-code 没给 <pre> 加 tabindex，点击代码区不会产生焦点，
    所以纯 CSS 的 :focus-within 拿不到这个状态，只能在这里补一个类。
    显隐规则见 src/styles/expressive-code.css 的 @media (hover: none) 段。
-->


</Layout>
