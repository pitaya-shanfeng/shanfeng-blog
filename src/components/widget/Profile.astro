---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        {profileConfig.contact && (profileConfig.contact.wechat || profileConfig.contact.email) ? (
            <div class="flex flex-col items-start gap-1.5 mx-auto mb-1 w-fit text-sm transition">
                {profileConfig.contact.wechat && (
                    <button
                        type="button"
                        data-copy-wechat={profileConfig.contact.wechat}
                        title="点击复制微信号"
                        class="group flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400 cursor-pointer hover:text-(--primary) transition"
                    >
                        <Icon name="fa7-brands:weixin" class="text-[1.05rem] shrink-0"></Icon>
                        <span class="select-none font-medium text-neutral-700 dark:text-neutral-200 group-hover:text-(--primary) transition">{profileConfig.contact.wechat}</span>
                        <Icon name="material-symbols:content-copy" class="text-[0.85rem] opacity-0 group-hover:opacity-60 transition" data-copy-hint></Icon>
                    </button>
                )}
                {profileConfig.contact.email && (
                    <a
                        href={`mailto:${profileConfig.contact.email}`}
                        title="发邮件"
                        class="group flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400 hover:text-(--primary) transition"
                    >
                        <Icon name="material-symbols:mail-outline" class="text-[1.05rem] shrink-0"></Icon>
                        <span class="font-medium text-neutral-700 dark:text-neutral-200 group-hover:text-(--primary) transition">{profileConfig.contact.email}</span>
                    </a>
                )}
            </div>
        ) : (
        <div class="flex flex-wrap gap-2 justify-center mb-1">

            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
        )}
  </div>
</div>

<script>
	// 微信号点击复制：不弹窗，把「已复制」写在原位置，2 秒后还原
	const hintText = "已复制";
	document.querySelectorAll<HTMLButtonElement>("[data-copy-wechat]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			const value = btn.dataset.copyWechat || "";
			if (!value) return;
			const label = btn.querySelector("span");
			if (!label) return;
			const original = label.textContent || "";
			const flash = (text: string) => {
				label.textContent = text;
				window.setTimeout(() => {
					label.textContent = original;
				}, 1600);
			};

			try {
				await navigator.clipboard.writeText(value);
				flash("已复制");
			} catch {
				// 非安全上下文或没授权时 clipboard 不可用：选中文本，提示手动复制
				const range = document.createRange();
				range.selectNodeContents(label);
				const sel = window.getSelection();
				sel?.removeAllRanges();
				sel?.addRange(range);
				flash("已选中，按 ⌘C");
			}
		});
	});
</script>
