---
/**
 * 推荐阅读（侧栏，合集页）
 *
 * 不自己写列表样式——直接复用模版的「相关文章」组件（RelatedPosts）：
 * 序号徽章、标题、箭头、虚线分隔、悬停态全站一套，改一次两处生效。
 * 两处不同：标题换成「推荐阅读」，并且不显示分类标签（这 10 篇跨分类挑的，
 * 标分类会干扰「先读哪篇」）。
 *
 * 名单在 src/config/recommendedReadingConfig.ts。
 * 显示范围：合集页显示、文章页与书籍页隐藏（见 SideBar 的 widget-hide-* 规则）。
 */
import RelatedPosts from "@/components/widget/RelatedPosts.astro";
import { RECOMMENDED_READING } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";
import { getSortedPosts, type PostForList } from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const posts = await getSortedPosts();
const byId = new Map(posts.map((post) => [post.id, post]));

const list: PostForList[] = RECOMMENDED_READING.flatMap((entry) => {
	const post = byId.get(entry.slug);
	return post ? [{ id: post.id, data: post.data }] : [];
});
---

{
	list.length > 0 && (
		<RelatedPosts
			posts={list}
			title="推荐阅读"
			showCategory={false}
			widgetId="recommended-reading-widget"
			widgetConfig={widgetConfig}
			class={className}
			style={style}
		/>
	)
}
