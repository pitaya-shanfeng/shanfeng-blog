---
/**
 * 本书目录（书籍合集页侧栏）
 *
 * 直接复用母版的 SidebarTOC 组件与它的全部样式（.toc-item / .toc-badge / .toc-label），
 * 只把内容换成书页的章节，并走「外链目录」模式：
 *   - 徽章沿用母版的圆形序号（章=数字、篇=圆点、序/后记=文字）
 *   - 层级：篇 = 1，章 = 2
 *   - 条目指向各章文章（跨页），因此不做页内 scrollspy；
 *     「读到哪」的当前项由 book-progress-utils 在客户端标记
 */
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import { booksConfig } from "@/config";
import { getSeriesPostsOf } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

/**
 * 当前是哪本书：从路径 /books/<id>/ 取。
 * 不能写死 booksConfig[0] —— 站里已经有两本书，写死会让第二本书的侧栏
 * 显示第一本的目录。
 * Astro.url.pathname 在 SSG 下是当前页面的路径（只有 query 会丢，pathname 是准的）。
 */
const currentBookId = Astro.url.pathname.match(/^\/books\/([^/]+)\/?$/)?.[1];
const book =
	booksConfig.find((item) => item.id === currentBookId) ?? booksConfig[0];
const posts = await getSeriesPostsOf(book.title);
const byOrder = new Map(posts.map((post) => [post.data.seriesOrder ?? 0, post]));

/** 目录连续编号：序是 01，第 1 章是 02，依次顺延 */
const nextBadge = () => String(items.length + 1).padStart(2, "0");

const items: {
	badge: string;
	text: string;
	href: string;
	depthLevel: number;
	badgeKind: "index" | "dot";
	anchor: string;
}[] = [];

if (book.preface) {
	const post = byOrder.get(book.preface.order);
	if (post) {
		items.push({
			badge: nextBadge(),
			text: post.data.title,
			href: getPostUrlBySlug(post.id),
			// 目录是 01–23 的扁平清单，序 / 章 / 后记同级；用 1 会缩进 8.6px 导致整列错开
			depthLevel: 2,
			badgeKind: "index",
			anchor: `ch-${post.id}`,
		});
	}
}

for (const part of book.parts) {
	for (const entry of part.entries) {
		// 「附」是上一篇的附属，不是一章，不进目录
		if (entry.label.includes("附")) continue;
		const post = byOrder.get(entry.order);
		if (!post) continue;
		items.push({
			badge: nextBadge(),
			text: post.data.title,
			href: getPostUrlBySlug(post.id),
			depthLevel: 2,
			badgeKind: "index",
			anchor: `ch-${post.id}`,
		});
	}
}

if (book.afterword) {
	const post = byOrder.get(book.afterword.order);
	if (post) {
		items.push({
			badge: nextBadge(),
			text: post.data.title,
			href: getPostUrlBySlug(post.id),
			// 同序言：与章节同级，保证徽章与文字左右都对齐
			depthLevel: 2,
			badgeKind: "index",
			anchor: `ch-${post.id}`,
		});
	}
}
---

<SidebarTOC
  items={items}
  mode="link"
  title="本书目录"
  contentId="book-toc-content"
  class={className}
  style={style}
/>

<style>
  /*
   * 书页的「本书目录」放宽高度上限。
   *
   * SidebarTOC 原本用 calc(100vh - 21rem)，是为了和右栏「相关文章」齐平；
   * 书页只有左栏、没有右栏，不存在这个对齐需求。按原值，17 条只能显示到约 14 条，
   * 后面几条要靠卡片内滚动才看得到，看起来就像「目录没更新」。
   * 只对 mode="link"（书页专用的跨页目录）生效，文章页的页内目录不受影响。
   */
  :global(.toc-scroll-container[data-toc-mode="link"]) {
    max-height: calc(100vh - 12rem);
  }
</style>
