---
/**
 * 本书目录（书籍合集页侧栏）
 *
 * 直接复用母版的 SidebarTOC 组件与它的全部样式（.toc-item / .toc-badge / .toc-label），
 * 只把内容换成书页的章节，并走「外链目录」模式：
 *   - 徽章沿用母版的圆形序号（章=数字、篇=圆点、序/后记=文字）
 *   - 层级：篇 = 1，章 = 2
 *   - 条目指向各章文章（跨页），因此不做页内 scrollspy；
 *     「读到哪」的当前项由 book-progress-utils 在客户端标记
 */
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import { booksConfig } from "@/config";
import { getSeriesPostsOf } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

/**
 * 当前是哪本书：从路径 /books/<id>/ 取。
 * 不能写死 booksConfig[0] —— 站里已经有两本书，写死会让第二本书的侧栏
 * 显示第一本的目录。
 * Astro.url.pathname 在 SSG 下是当前页面的路径（只有 query 会丢，pathname 是准的）。
 */
const currentBookId = Astro.url.pathname.match(/^\/books\/([^/]+)\/?$/)?.[1];
const book =
	booksConfig.find((item) => item.id === currentBookId) ?? booksConfig[0];
const seriesCache = new Map<
	string,
	Map<number, Awaited<ReturnType<typeof getSeriesPostsOf>>[number]>
>();
const byOrderOf = async (target: typeof book) => {
	const hit = seriesCache.get(target.title);
	if (hit) return hit;
	const posts = await getSeriesPostsOf(target.title);
	const map = new Map(posts.map((post) => [post.data.seriesOrder ?? 0, post]));
	seriesCache.set(target.title, map);
	return map;
};

/** 当前页是书页时，用它决定哪一组默认展开 */
const activeBookId = book.id;

/**
 * 按一本书算出目录项。
 * 抽成函数是因为侧栏里要把**每一本书**的目录都渲染出来：
 * 侧栏在 swup 容器之外、站内跳转不重建 DOM，只渲染当前书会导致
 * 从见山跳到增长黑客时目录停在上本书（现在这个 bug 的根因）。
 */
function buildItems(
	target: typeof book,
	targetPosts: Awaited<ReturnType<typeof byOrderOf>>,
) {
	const items: {
		badge: string;
		text: string;
		href: string;
		depthLevel: number;
		badgeKind: "index" | "dot";
		anchor: string;
	}[] = [];
	/** 目录连续编号：序是 01，第 1 章是 02，依次顺延 */
	const nextBadge = () => String(items.length + 1).padStart(2, "0");

	if (target.preface) {
		const post = targetPosts.get(target.preface.order);
		if (post) {
			items.push({
				badge: nextBadge(),
				text: post.data.title,
				href: getPostUrlBySlug(post.id),
				depthLevel: 2,
				badgeKind: "index",
				anchor: `ch-${post.id}`,
			});
		}
	}

	for (const part of target.parts) {
		for (const entry of part.entries) {
			// 「附」是上一篇的附属，不是一章，不进目录
			if (entry.label.includes("附")) continue;
			const post = targetPosts.get(entry.order);
			if (!post) continue;
			items.push({
				badge: nextBadge(),
				text: post.data.title,
				href: getPostUrlBySlug(post.id),
				depthLevel: 2,
				badgeKind: "index",
				anchor: `ch-${post.id}`,
			});
		}
	}

	if (target.afterword) {
		const post = targetPosts.get(target.afterword.order);
		if (post) {
			items.push({
				badge: nextBadge(),
				text: post.data.title,
				href: getPostUrlBySlug(post.id),
				depthLevel: 2,
				badgeKind: "index",
				anchor: `ch-${post.id}`,
			});
		}
	}
	return items;
}

const groups: { id: string; items: ReturnType<typeof buildItems> }[] = [];
for (const b of booksConfig) {
	groups.push({ id: b.id, items: buildItems(b, await byOrderOf(b)) });
}

---

<SidebarTOC
  groups={groups}
  activeGroup={activeBookId}
  mode="link"
  title="本书目录"
  contentId="book-toc-content"
  id="book-toc-card"
  class={className}
  style={style}
/>

<script>
  /**
   * 侧栏在 swup 容器之外：站内跳转只换 #swup-container，侧栏 DOM 原样保留。
   * 所以这里把所有书的目录一次渲染好，切页后按 URL 显示对应那一组 ——
   * 和「往期目录」（HotnewsIndex）的显隐同步是同一套做法。
   */
  (function () {
    if (window.__bookTocSync) return;
    window.__bookTocSync = true;

    function sync() {
      const card = document.getElementById("book-toc-card");
      if (!card) return;
      const m = window.location.pathname.match(/^\/books\/([^/]+)\/?$/);
      const groups = card.querySelectorAll<HTMLElement>(".toc-group[data-book-id]");
      if (!m) {
        // 非书页：整张卡由 .widget-hide-on-non-book 的同步逻辑收起，
        // 这里只保证下次进书页时分组是对的那一本。
        return;
      }
      const id = m[1];
      groups.forEach((g) => {
        g.hidden = g.dataset.bookId !== id;
      });
      // 目录换了，当前章的标记要按新页重算
      document.dispatchEvent(new CustomEvent("book-toc:switched"));
    }

    sync();

    document.addEventListener("swup:page:view", sync);
    document.addEventListener("swup:contentReplaced", sync);
    document.addEventListener("swup:content:replace", sync);
    window.addEventListener("popstate", sync);

    // 兜底：不依赖 swup 的事件名，容器一被替换就重算
    const container = document.getElementById("swup-container");
    if (container) {
      new MutationObserver(sync).observe(container, { childList: true });
    }
  })();
</script>

<style>
  /*
   * 书页的「本书目录」放宽高度上限。
   *
   * SidebarTOC 原本用 calc(100vh - 21rem)，是为了和右栏「相关文章」齐平；
   * 书页只有左栏、没有右栏，不存在这个对齐需求。按原值，17 条只能显示到约 14 条，
   * 后面几条要靠卡片内滚动才看得到，看起来就像「目录没更新」。
   * 只对 mode="link"（书页专用的跨页目录）生效，文章页的页内目录不受影响。
   */
  :global(.toc-scroll-container[data-toc-mode="link"]) {
    max-height: calc(100vh - 12rem);
  }
</style>
