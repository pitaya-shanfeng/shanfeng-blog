---
import type { MarkdownHeading } from "astro";
import "@/styles/toc.css";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { computeTocItems } from "@/utils/toc-shared";

/** 外部传入的目录项（跨页链接时用），字段与页内目录保持同一套渲染结构 */
export interface TocLinkItem {
	/** 徽章文本：数字序号 / 「序」/「附」/「后记」 */
	badge: string;
	/** 条目文字 */
	text: string;
	/** 链接地址 */
	href: string;
	/** 层级：1 = 篇，2 = 章 */
	depthLevel?: number;
	/** 徽章类型：index = 数字徽章，dot = 圆点 */
	badgeKind?: "index" | "dot";
	/** 文字是否为主色（深色） */
	labelPrimary?: boolean;
	/** 是否为当前项 */
	isActive?: boolean;
	/** 锚点标识（外链目录用，客户端据此标记当前项） */
	anchor?: string;
}

interface Props {
	headings?: MarkdownHeading[];
	/** 传入 items 时按外链目录渲染（不做页内 scrollspy） */
	items?: TocLinkItem[];
	/** anchor = 页内目录（默认）；link = 跨页目录 */
	mode?: "anchor" | "link";
	/** 覆盖组件标题 */
	title?: string;
	/** 内容容器 id（同一页面可能出现两个目录） */
	contentId?: string;
	encrypted?: boolean;
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const {
	headings = [],
	items: linkItems,
	mode = "anchor",
	title,
	contentId = "sidebar-toc-content",
	encrypted = false,
	class: className,
	style,
	widgetConfig,
} = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 加密文章不在服务端渲染目录（避免标题泄露），交由客户端解密后生成
const items = encrypted
	? []
	: mode === "link"
		? (linkItems ?? [])
		: computeTocItems(headings, { maxLevel: 3 });
---

<WidgetLayout
  name={title ?? i18n(I18nKey.tableOfContents)}
  showTitle={showTitle}
  id="sidebar-toc"
  class={className}
  style={style}
>
  <div class="toc-scroll-container custom-scrollbar" data-toc-mode={mode}>
    <div
      class="toc-content"
      id={contentId}
    >
      {!encrypted && items.length > 0 && (
        <>
          {items.map((item) => (
            <a
              href={item.href}
              class={`toc-item toc-level-${item.depthLevel ?? 2}${item.isActive ? " toc-item-active" : ""}`}
              data-heading-id={item.headingId ?? item.href}
              data-anchor={item.anchor}
              aria-label={item.text}
              title={item.text}
              aria-current={item.isActive ? "true" : undefined}
            >
              <div class={`toc-badge ${item.badgeKind === "index" ? "toc-badge-index" : ""}`}>
                {mode === "link" ? (
                  item.badge
                ) : item.badgeKind === "index" ? (
                  item.badgeIndex
                ) : item.badgeKind === "dot" ? (
                  <span class="toc-badge-dot"></span>
                ) : (
                  <span class="toc-badge-dot toc-badge-dot-sm"></span>
                )}
              </div>
              <div class={`toc-label ${item.labelPrimary ? "toc-label-primary" : "toc-label-secondary"}`}>
                {item.text}
              </div>
            </a>
          ))}
          <div id="sidebar-active-indicator" class="toc-active-indicator" style="opacity: 0;"></div>
        </>
      )}
      {!encrypted && items.length === 0 && (
        <div class="text-center py-8 text-gray-500 dark:text-gray-400">
          <p>{i18n(I18nKey.tocEmpty)}</p>
        </div>
      )}
      {/* 加密文章：留空，客户端解密后由 TOCManager 填充 */}
    </div>
  </div>
</WidgetLayout>

<style lang="stylus">
/* SidebarTOC 特定样式 */
.toc-scroll-container
	/* 目录最高能到哪里：与右栏「相关文章」大致齐平。
	   整块高度 = 组件头 52 + 本容器 + 下内边距 16，所以容器按 100vh - 21rem 取，
	   在 950 高的窗口下约 614（整块 ≈ 682，右栏相关文章为 689）。
	   原值是 calc(100vh - 25rem)（=550），比右栏矮一截，长目录会过早出现内部滚动条。
	   调大 → 目录更高；调小 → 更早开始滚动。 */
	max-height: calc(100vh - 21rem)
	/* 滚动条与内容之间的小间隙（从共享样式挪入，避免影响浮动目录的对称内边距） */
	padding-right: 0.125rem
</style>

<script>
  import { TOCManager } from "@/utils/toc-utils";

  if (typeof window.SidebarTOC === "undefined") {
    window.SidebarTOC = {
      manager: null
    };
  }

  // 侧栏目录在 #right-sidebar-static 内，不是 swup 容器：站内导航后其 DOM 不被替换。
  // attach() 内部会校验现有锚点是否属于当前正文——新鲜则直接附着（首屏 SSR），
  // 过时或缺失（导航后/加密解密后）则自动回退 DOM 遍历重建，无需在此区分场景。
  function initSidebarTOC() {
    const tocContent = document.getElementById("sidebar-toc-content");
    if (!tocContent) return;
    // 外链目录（书页的本书目录）不做页内 scrollspy：
    // 它的条目指向其他页面，没有可观察的页内锚点。
    // ⚠️ 只能判断「当前要初始化的这一个容器」——侧栏是静态容器，
    // 书页那套 link 容器站内跳转后也一直留在 DOM 里，
    // 用全局 querySelector 会让所有页面的目录都失去客户端重建能力。
    const scroll = tocContent.closest(".toc-scroll-container");
    if (scroll?.dataset.tocMode === "link") return;

    try {
      // 清理旧实例
      if (window.SidebarTOC.manager) {
        window.SidebarTOC.manager.cleanup();
      }

      // 创建新实例
      window.SidebarTOC.manager = new TOCManager({
        contentId: "sidebar-toc-content",
        indicatorId: "sidebar-active-indicator",
        maxLevel: 3,
        scrollOffset: 80,
      });

      window.SidebarTOC.manager.attach();
    } catch (error) {
      console.error("Failed to load TOCManager for SidebarTOC:", error);
    }
  }

  // 防止 Swup 切页重跑脚本时重复注册监听器（initSidebarTOC 由下方一次性监听器在切页时触发）
  if (!window.__sidebarTOCInit) {
    window.__sidebarTOCInit = true;

    // 初始化
    // 确保 DOM 准备好后再执行
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSidebarTOC);
    } else {
      initSidebarTOC();
    }

    // 页面切换时重新初始化
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(initSidebarTOC, 100);
    });

    // Astro 页面切换事件
    document.addEventListener("astro:page-load", () => {
      setTimeout(initSidebarTOC, 100);
    });

    // 浏览器导航事件
    window.addEventListener("popstate", () => {
      setTimeout(initSidebarTOC, 200);
    });

    // 监听 hashchange（但排除 TOC 内部导航）
    window.addEventListener("hashchange", () => {
      if (!window.tocInternalNavigation) {
        setTimeout(initSidebarTOC, 100);
      }
      window.tocInternalNavigation = false;
    });

    // 密码解密后重新初始化 TOC（需 DOM 遍历重建）
    document.addEventListener("password:decrypted", () => {
      setTimeout(initSidebarTOC, 200);
    });
  }
</script>
