---
/**
 * 首页两条通栏色带（设计稿第 2、3 屏）
 *
 * 两本书：蓝紫渐变，两张白卡（每日行业动态已撤，banner 右上已有晨报卡）
 */
import { Icon } from "astro-icon/components";
import { booksConfig } from "@/config/booksConfig";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";
import "@/styles/home-bands.css";

const allWithBooks = await getSortedPostsList(true);
const countOf = (cat: string) =>
	allWithBooks.filter((p) => (p.data.category ?? "").includes(cat)).length;

const books = booksConfig
	.filter((b) => b.id === "jianshan" || b.id === "zengzhang")
	.map((b, i) => ({
		no: `BOOK 0${i + 1}`,
		cover: b.cover,
		title: b.title,
		kicker: b.kicker ?? "",
		lead: b.lead,
		count: countOf(b.id === "jianshan" ? "书·见山" : "书·增长"),
		href: `/books/${b.id}/`,
	}));
---

{/* ── 两本书 ─────────────────────────────────── */}
<section class="band band-books" aria-labelledby="band-books-title">
	{/* 装饰块：设计稿里那几枚浅色几何形 */}
	<span class="deco deco-square" aria-hidden="true"></span>
	<span class="deco deco-bar" aria-hidden="true"></span>
	<span class="deco deco-ring" aria-hidden="true"></span>
	<span class="deco deco-blob" aria-hidden="true"></span>

	<div class="band-inner">
		<p class="band-kicker">BOOKS · 写作</p>
		<h2 id="band-books-title" class="band-title">两本书，把想清楚的写完整</h2>
		<p class="band-sub">一本讲产品判断力，一本讲增长黑客方法。</p>

		<div class="books-grid">
			{books.map((b) => (
				<a class="book-card" href={url(b.href)}>
					<img class="book-cover" src={b.cover} alt={`${b.title} 封面`} loading="lazy" />
					<div class="book-body">
					<p class="book-no">{b.no}</p>
					<h3 class="book-name">{b.title}</h3>
					<p class="book-lead">{b.lead}</p>
					<span class="book-meta">
						{b.count} 篇 · 从第一篇开始读
						<Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
					</span>
					</div>
				</a>
			))}
		</div>
	</div>
</section>
