---
/**
 * 首页正文（banner 之下）
 *
 * 目前只保留「四维能力矩阵」一条能力带；精选、两本书、索引、学习记录、作者卡
 * 先撤下，等新的版式定稿再逐块加回来。
 */
import "@/styles/home-landing.css";

/** 四维能力矩阵：只展示，不跳转 */
const capabilities = [
	{
		icon: "/assets/images/capabilities/domain.png",
		title: "深耕电商与消费生态",
		tag: "传统零售 · 新零售 · 消费金融",
	},
	{
		icon: "/assets/images/capabilities/architecture.png",
		title: "全链路产品架构设计",
		tag: "前台 · 中台 · 平台",
	},
	{
		icon: "/assets/images/capabilities/growth.png",
		title: "以数据驱动的增长黑客",
		tag: "从 0 到 1 · 数据策略",
	},
	{
		icon: "/assets/images/capabilities/team.png",
		title: "复杂项目的定海神针",
		tag: "带团队 · 跨部门交付",
	},
];
---

<div class="home-landing">
	{/* 四维能力矩阵（不可点击） */}
	<section class="hl-caps" aria-label="四维能力矩阵">
		<div class="hl-caps-grid">
			{capabilities.map((c) => (
				<div class="hl-cap">
					<span class="hl-cap-icon" aria-hidden="true">
						<img src={c.icon} alt="" loading="lazy" />
					</span>
					<div class="hl-cap-body">
						<h3 class="hl-cap-title">{c.title}</h3>
						<p class="hl-cap-tag">{c.tag}</p>
					</div>
				</div>
			))}
		</div>
	</section>
</div>
