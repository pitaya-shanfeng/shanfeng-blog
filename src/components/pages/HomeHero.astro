---
/**
 * 首页 Hero（按 2026-11-12 设计稿）
 *
 * 浅色渐变底 + 左文右卡：左侧标题、说明、两个入口、三个数字；
 * 右侧一叠悬浮卡（今日晨报 / BOOK 01 见山）。
 */
import { Icon } from "astro-icon/components";
import { booksConfig } from "@/config/booksConfig";
import { getDailyBrief } from "@/utils/daily-brief";
import { url } from "@/utils/url-utils";
import "@/styles/home-hero.css";

const brief = await getDailyBrief();
const jianshan = booksConfig.find((b) => b.id === "jianshan");

const now = new Date();
const today = {
	day: `${String(now.getMonth() + 1).padStart(2, "0")}.${String(now.getDate()).padStart(2, "0")}`,
	line: `周${"日一二三四五六"[now.getDay()]}`,
};
---

<section class="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="hero-chip">
				<span class="dot" aria-hidden="true"></span>
				知识仓库 · 日常行业洞察
			</p>

			<h1 class="hero-title">
				做个靠谱的<br />
				<span class="accent">产品经理</span>
			</h1>

			<p class="hero-lead">
				不堆黑话，聊聊产品判断力：在噪音中看清本质，在取舍之间守住方向，让每一次决策都经得起推敲！
			</p>

			<div class="hero-actions">
				<a class="btn btn-primary" href={url("/archive/")}>
					开始阅读
					<Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
				</a>
				<a class="btn btn-ghost" href={url("/about/")}>
					认识山风
					<Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
				</a>
			</div>

			<dl class="hero-stats">
				<div><dt>12 年+</dt><dd>产品经验</dd></div>
				<div><dt>100+</dt><dd>篇记录</dd></div>
				<div><dt>2 本</dt><dd>连载中的书</dd></div>
			</dl>
		</div>

		<div class="hero-cards">
			<a class="hcard hcard-brief" href={brief?.href ?? url("/hotnews/")}>
				<div class="hcard-head">
					<span class="hcard-label">今日晨报</span>
					<span class="hcard-date">{today.day} · {today.line}</span>
				</div>
				<p class="hcard-title">{brief?.headline ?? "今日行业动态"}</p>
				<p class="hcard-desc">{brief?.summary}</p>
				<span class="hcard-more">查看完整版 <Icon name="material-symbols:arrow-outward-rounded" class="text-sm" /></span>
			</a>

			{jianshan && (
				<a class="hcard hcard-book" href={url("/books/jianshan/")}>
					<span class="hcard-label">BOOK 01 · 连载中</span>
					<p class="hcard-book-title">《见山》产品判断</p>
					<span class="hcard-more">24 篇 · 从第一篇开始读 <Icon name="material-symbols:arrow-forward-rounded" class="text-sm" /></span>
				</a>
			)}
		</div>
	</div>
</section>
