---
import type { MarkdownHeading } from "astro";
import Advertisement from "@/components/widget/Advertisement.astro";
import Announcement from "@/components/widget/Announcement.astro";
import Calendar from "@/components/widget/Calendar.astro";
import BookProgress from "@/components/widget/BookProgress.astro";
import HotnewsIndex from "@/components/widget/HotnewsIndex.astro";
import RecommendedReading from "@/components/widget/RecommendedReading.astro";
import Categories from "@/components/widget/Categories.astro";
import Dynamic from "@/components/widget/Dynamic.astro";
import Music from "@/components/widget/Music.astro";
import Profile from "@/components/widget/Profile.astro";
import RelatedPosts from "@/components/widget/RelatedPosts.astro";
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import SiteInfo from "@/components/widget/SiteInfo.astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Tags from "@/components/widget/Tags.astro";
import { sidebarLayoutConfig } from "@/config";
import type {
	MobileBottomComponentConfig,
	WidgetComponentConfig,
} from "@/types/config";
import { isWidgetVisibleOnPageType } from "@/utils/responsive-utils";
import type { PostForList } from "@/utils/content-utils";
import { isArticleDetailPage, isBookPage, isCollectionListPage } from "@/utils/url-utils";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	side?: "left" | "right" | "bottom";
	/** 相关文章数据，由文章页计算后传入（侧栏只负责展示） */
	relatedPostList?: PostForList[];
	/** 当前文章分类。相关文章组件按配置里的 excludeCategories 决定要不要显形 */
	postCategory?: string;
}

// 侧边栏位置常量
const SIDEBAR_SIDE = {
	LEFT: "left",
	RIGHT: "right",
	BOTTOM: "bottom",
} as const;

// 组件位置常量
const COMPONENT_POSITION = {
	TOP: "top",
	STICKY: "sticky",
	BOTTOM: "bottom",
} as const;

// 动画延迟配置
const ANIMATION_DELAY_UNIT = 50; // ms

// 组件映射表
const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	sidebarToc: SidebarTOC,
	advertisement: Advertisement,
	stats: SiteStats,
	calendar: Calendar,
	music: Music,
	siteInfo: SiteInfo,
	dynamic: Dynamic,
	relatedPosts: RelatedPosts,
	bookProgress: BookProgress,
	hotnewsIndex: HotnewsIndex,
	recommendedReading: RecommendedReading,
};

// 获取侧边栏位置
const side = (Astro.props.side ||
	SIDEBAR_SIDE.LEFT) as (typeof SIDEBAR_SIDE)[keyof typeof SIDEBAR_SIDE];
const className = Astro.props.class;

// 根据 side 属性获取对应的组件列表
const getComponents = (): (
	| WidgetComponentConfig
	| MobileBottomComponentConfig
)[] => {
	if (side === SIDEBAR_SIDE.LEFT) {
		return sidebarLayoutConfig.leftComponents;
	}
	if (side === SIDEBAR_SIDE.RIGHT) {
		return sidebarLayoutConfig.rightComponents;
	}
	if (side === SIDEBAR_SIDE.BOTTOM) {
		return sidebarLayoutConfig.mobileBottomComponents;
	}
	return [];
};

// 过滤并排序组件（不再进行 showOnPostPage 过滤，交由客户端处理）
const filterAndSortComponents = (
	components: (WidgetComponentConfig | MobileBottomComponentConfig)[],
) => {
	return components.filter((comp) => comp.enable);
};

// 分离 top 和 sticky 位置的组件（保持原始数组顺序）
const getComponentsByPosition = (
	components: (WidgetComponentConfig | MobileBottomComponentConfig)[],
) => {
	const topComponents = components.filter(
		(c) => "position" in c && c.position === COMPONENT_POSITION.TOP,
	) as WidgetComponentConfig[];
	const stickyComponents = components.filter(
		(c) => "position" in c && c.position === COMPONENT_POSITION.STICKY,
	) as WidgetComponentConfig[];
	// 排在粘性容器之后的组件（常规流）：滚动时会滑到粘性组下面
	const bottomComponents = components.filter(
		(c) => "position" in c && c.position === COMPONENT_POSITION.BOTTOM,
	) as WidgetComponentConfig[];
	return { topComponents, stickyComponents, bottomComponents };
};

// 获取动画延迟（硬编码）
const getAnimationDelay = (index: number): string => {
	return `${index * ANIMATION_DELAY_UNIT}ms`;
};

// 判断当前页面是否为文章/项目详情页（服务端渲染时确定）
const isPostPage = isArticleDetailPage(Astro.url.pathname);

// 判断组件在当前页面首屏是否可见（用于计算布局间距，避免隐藏组件占位）
// 谓词与列几何共用 isWidgetVisibleOnPageType，避免两处规则漂移
const isComponentInitiallyVisible = (
	config: WidgetComponentConfig | MobileBottomComponentConfig,
): boolean => isWidgetVisibleOnPageType(config, isPostPage);

// 动态构建组件 props
const getComponentProps = (
	config: WidgetComponentConfig | MobileBottomComponentConfig,
	index: number,
): Record<string, unknown> => {
	const baseProps: Record<string, unknown> = {
		class: "onload-animation",
		style: `animation-delay: ${getAnimationDelay(index)}`,
		widgetConfig: config,
	};

	// 添加 showOnPostPage 和 hideOnNonPostPage 标记class（仅WidgetComponentConfig有这些属性）
	// 同时根据当前页面类型在服务端渲染时设置初始 hidden 状态，避免页面加载时闪烁
	if ("showOnPostPage" in config && config.showOnPostPage === false) {
		baseProps.class = `${baseProps.class} widget-hide-on-post`;
		if (isPostPage) {
			baseProps.class = `${baseProps.class} hidden`;
		}
	}
	if ("hideOnNonPostPage" in config && config.hideOnNonPostPage === true) {
		baseProps.class = `${baseProps.class} widget-hide-on-non-post`;
		if (!isPostPage) {
			baseProps.class = `${baseProps.class} hidden`;
		}
	}
	// 只在书籍合集页显示的组件（如本书阅读进度尺）
	if ("hideOnNonBookPage" in config && config.hideOnNonBookPage === true) {
		baseProps.class = `${baseProps.class} widget-hide-on-non-book`;
		if (!isBookPage(Astro.url.pathname)) {
			baseProps.class = `${baseProps.class} hidden`;
		}
	}

	// 只在分类合集页显示（侧栏推荐阅读）：其余页面首屏就带 hidden，避免闪
	if (
		"onlyOnCollectionPages" in config &&
		config.onlyOnCollectionPages === true
	) {
		baseProps.class = `${baseProps.class} widget-hide-outside-collection`;
		if (!isCollectionListPage(Astro.url.pathname)) {
			baseProps.class = `${baseProps.class} hidden`;
		}
	}

	// 特殊处理 SidebarTOC 组件
	if (config.type === "sidebarToc") {
		return {
			...baseProps,
			headings: Astro.props.headings || [],
			encrypted: Astro.props.encrypted || false,
		};
	}

	// 特殊处理相关文章组件（数据由文章页计算后透传，侧栏不做推荐逻辑）
	if (config.type === "relatedPosts") {
		// 有些分类不该出「相关文章」（行业动态：每天一期，推荐列表会稀释「最新」）。
		// 分类名单写在 sidebarConfig 的 specificConfig 里，这里只做判定与初始显隐——
		// 初始就带 hidden，避免首屏先画出列表再消失。
		const excludeCategories =
			config.specificConfig?.relatedPosts?.excludeCategories ?? [];
		const currentCategory = (Astro.props.postCategory || "").trim();
		const hideHere =
			!!currentCategory && excludeCategories.includes(currentCategory);
		return {
			...baseProps,
			// 不能复用 Tailwind 的 hidden：grid-layout-utils 会按 showOnPostPage /
			// hideOnNonPostPage 对 .hidden 做 add/remove，文章页上正好 remove，
			// 会把这里的隐藏一起撤掉。所以另开一个专用类。
			class: `${baseProps.class}${hideHere ? " widget-hide-by-category" : ""}`,
			posts: Astro.props.relatedPostList || [],
			// 名单要传到 DOM：客户端在 swup 切页后自己再判一次
			excludeCategories,
		};
	}

	return baseProps;
};

// 获取所有需要渲染的组件
const allComponents = getComponents();
const filteredComponents = filterAndSortComponents(allComponents);

// 对于移动端底部组件，直接使用所有组件，不进行position分组
const isMobileBottom = side === SIDEBAR_SIDE.BOTTOM;
const {
	topComponents,
	stickyComponents,
	bottomComponents: tailComponents,
} = !isMobileBottom
	? getComponentsByPosition(filteredComponents)
	: { topComponents: [], stickyComponents: [], bottomComponents: [] };
const bottomComponents = isMobileBottom ? filteredComponents : [];
const hasInitiallyVisibleTopComponents = topComponents.some(
	isComponentInitiallyVisible,
);
---

{
	(topComponents.length > 0 ||
		stickyComponents.length > 0 ||
		tailComponents.length > 0 ||
		bottomComponents.length > 0) && (
		<div id={`${side}-sidebar`} class:list={[className, "flex flex-col w-full pt-0"]}>
			{/* Mobile bottom components - 直接渲染所有组件，不分组 */}
			{isMobileBottom ? (
				<div class="flex flex-col w-full gap-4">
					{bottomComponents.map((comp, index) => {
						const Component = componentMap[comp.type];
						if (!Component) return null;
						const props = getComponentProps(comp, index) as any;
						return <Component {...props} />;
					})}
				</div>
			) : (
				<>
					{/* Top components */}
					{topComponents.length > 0 && (
						<div
							class:list={[
								"flex flex-col w-full gap-4",
								hasInitiallyVisibleTopComponents && "mb-4",
							]}
						>
							{topComponents.map((comp, index) => {
								const Component = componentMap[comp.type];
								if (!Component) return null;
								const props = getComponentProps(comp, index) as any;
								return <Component {...props} />;
							})}
						</div>
					)}

					{/* Sticky components */}
					{stickyComponents.length > 0 && (
						<div
							id={`${side}-sidebar-sticky`}
							class:list={[
								"flex flex-col w-full mt-0 gap-4",
								"sticky z-10",
								hasInitiallyVisibleTopComponents ? "top-4" : "top-0",
							]}
						>
							{stickyComponents.map((comp, index) => {
								const Component = componentMap[comp.type];
								if (!Component) return null;
								const props = getComponentProps(
									comp,
									topComponents.length + index
								) as any;
								return <Component {...props} />;
							})}
						</div>
					)}

					{/* 排在粘性组之后的组件（常规流）：滚动时滑到粘性组下面，故粘性组加了 z-10 */}
					{tailComponents.length > 0 && (
						<div class="flex flex-col w-full gap-4 mt-4">
							{tailComponents.map((comp, index) => {
								const Component = componentMap[comp.type];
								if (!Component) return null;
								const props = getComponentProps(
									comp,
									topComponents.length + stickyComponents.length + index
								) as any;
								return <Component {...props} />;
							})}
						</div>
					)}
				</>
			)}
		</div>
	)
}
