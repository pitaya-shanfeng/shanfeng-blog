---
/**
 * 分类栏
 *
 * 数据源是导航菜单的一二级结构（`navCategoryGroups`）。站内的「分类」只有一套——
 * 每个一级 / 二级菜单就是一个分类，文章的 category 也按 `一级/二级` 两级写，
 * 卡片上的「写作/见山」「拾遗 / 学习笔记」都是这同一个值。
 * 所以这里不能再拿 `getCategoryList()` 聚合：那会冒出既不是栏目、又没人认识的条目。
 *
 * 版式：两行。
 *   上行 —— 首页 + 四个一级栏（写作 / 方法 / 案例 / 拾遗）+ 归档入口（图标，放最右）
 *   下行 —— 当前一级栏下的栏目，点栏目才跳转；切栏只换下行内容，不导航
 * 上行用文字 tab 样式（选中带下划线），下行沿用胶囊 pill，两级视觉上不会混。
 *
 * 归档不再是「分类」，退成一个图标入口 —— 它是个页面，不是一个栏目；
 * 但站内没有别的地方链到 /archive/，完全撤掉就没有入口了。
 */

import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { navCategoryGroups } from "@/config/navBarConfig";
import { url } from "@/utils/url-utils";

interface Props {
	currentPostCategory?: string;
}

const { currentPostCategory } = Astro.props as Props;

const homeUrl = url("/");
const archiveUrl = url("/archive/");
const groups = navCategoryGroups;

/** 与客户端脚本里的 keyFromUrl 同一套规则：路径去尾斜杠 + 查询串排序 */
function keyFromUrl(href: string): string {
	const u = new URL(href, "https://site.invalid");
	const path = u.pathname.replace(/\/+$/, "") || "/";
	const q = [...u.searchParams.entries()]
		.sort((a, b) => a[0].localeCompare(b[0]))
		.map(([k, v]) => `${k}=${v}`)
		.join("&");
	return q ? `${path}?${q}` : path;
}

const currentKey = keyFromUrl(
	Astro.url.pathname + (Astro.url.search || ""),
);
const homeKey = keyFromUrl(homeUrl);
const archiveKey = keyFromUrl(archiveUrl);
const isHome = currentKey === homeKey;
const isArchive = currentKey === archiveKey;

// 当前地址命中哪个栏目，就默认展开它所属的一级栏；没命中则落在第一栏
let initialGroup = groups[0]?.name ?? "";
let initialItem = "";
for (const group of groups) {
	for (const item of group.items) {
		if (keyFromUrl(item.url) === currentKey) {
			initialGroup = group.name;
			initialItem = item.url;
		}
	}
}
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-home-path={homeUrl}
  data-archive-path={archiveUrl}
  data-current-post-category={currentPostCategory || ""}
  data-groups={JSON.stringify(
    groups.map((group) => ({
      name: group.name,
      items: group.items.map((item) => ({ name: item.name, url: item.url })),
    })),
  )}
>
  <div class="category-bar-inner flex items-center gap-2">
    <a
      href={homeUrl}
      class="cat-home category-pill focus-ring-inset text-sm px-3 py-1.5 shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name=""
      data-active={isHome ? "" : undefined}
      aria-label={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home" class="text-lg" />
    </a>

    <div class="group-tabs min-w-0">
      {
        groups.map((group) => (
          <button
            type="button"
            class="group-tab"
            data-group={group.name}
            data-active={group.name === initialGroup ? "" : undefined}
            aria-selected={group.name === initialGroup}
            role="tab"
          >
            {group.name}
          </button>
        ))
      }
    </div>

    <a
      href={archiveUrl}
      class="cat-archive category-pill focus-ring-inset text-sm px-3 py-1.5 shrink-0 ml-auto
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-active={isArchive ? "" : undefined}
      aria-label={i18n(I18nKey.archive)}
      title={i18n(I18nKey.archive)}
    >
      <Icon name="material-symbols:archive" class="text-lg" />
    </a>
  </div>

  <div class="sub-row">
    {
      groups.map((group) => (
        <div
          class="sub-group"
          data-sub-of={group.name}
          hidden={group.name !== initialGroup}
        >
          {group.items.map((item) => (
            <a
              href={item.url}
              class="sub-pill category-pill focus-ring-inset text-sm px-4 py-1.5
                     whitespace-nowrap transition-colors duration-150 ease-out
                     inline-flex items-center justify-center"
              data-active={item.url === initialItem ? "" : undefined}
            >
              {item.name}
            </a>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-bar .category-pill {
    border: none;
  }

  /* 一级栏：文字 tab，选中带下划线，刻意与下行的胶囊拉开层级 */
  .group-tabs {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .group-tabs::-webkit-scrollbar {
    display: none;
  }
  .group-tab {
    position: relative;
    flex-shrink: 0;
    padding: 0.375rem 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--btn-content);
    opacity: 0.62;
    white-space: nowrap;
    border-radius: 0.5rem;
    transition: color 150ms ease-out, opacity 150ms ease-out;
    cursor: pointer;
  }
  .group-tab:hover {
    color: var(--primary);
    opacity: 1;
  }
  .group-tab[data-active] {
    color: var(--primary);
    opacity: 1;
  }
  .group-tab[data-active]::after {
    content: "";
    position: absolute;
    left: 0.625rem;
    right: 0.625rem;
    bottom: -0.0625rem;
    height: 2px;
    border-radius: 1px;
    background: var(--primary);
  }

  /* 二级栏目：一行胶囊，横向滚动 */
  .sub-row {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line-divider);
  }
  .sub-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .sub-group[hidden] {
    display: none;
  }
  .sub-group::-webkit-scrollbar {
    display: none;
  }
  .sub-pill {
    flex-shrink: 0;
    font-size: 0.8125rem;
  }
</style>

<script>
  interface BarGroup {
    name: string;
    items: { name: string; url: string }[];
  }

  /** 统一成「路径去尾斜杠 + 查询串按 key 排序」，服务端与客户端同一套规则 */
  function keyFromUrl(href: string, base?: string): string {
    const u = new URL(href, base || window.location.origin);
    const path = u.pathname.replace(/\/+$/, "") || "/";
    const q = [...u.searchParams.entries()]
      .sort((a, b) => a[0].localeCompare(b[0]))
      .map(([k, v]) => `${k}=${v}`)
      .join("&");
    return q ? `${path}?${q}` : path;
  }

  function parseGroups(bar: HTMLElement): BarGroup[] {
    try {
      return JSON.parse(bar.dataset.groups || "[]");
    } catch {
      return [];
    }
  }

  function setFlag(el: Element | null, attr: string, on: boolean) {
    if (!el) return;
    if (on) el.setAttribute(attr, "");
    else el.removeAttribute(attr);
  }

  /** 按当前地址重算：展开哪一栏、高亮哪个栏目 */
  function syncState(bar: HTMLElement, currentUrl: URL) {
    const groups = parseGroups(bar);
    if (!groups.length) return;

    const key = keyFromUrl(currentUrl.href, currentUrl.origin);
    const homeKey = keyFromUrl(bar.dataset.homePath || "/", currentUrl.origin);
    const archiveKey = keyFromUrl(
      bar.dataset.archivePath || "/archive/",
      currentUrl.origin,
    );

    let activeGroup = groups[0].name;
    let activeItem = "";
    // 手动切过栏、且当前地址没命中任何栏目时，保留用户的选择
    const manual = bar.dataset.manualGroup || "";
    let matched = false;

    for (const group of groups) {
      for (const item of group.items) {
        if (keyFromUrl(item.url, currentUrl.origin) === key) {
          activeGroup = group.name;
          activeItem = item.url;
          matched = true;
        }
      }
    }
    if (!matched && manual) activeGroup = manual;

    setFlag(bar.querySelector(".cat-home"), "data-active", key === homeKey);
    setFlag(
      bar.querySelector(".cat-archive"),
      "data-active",
      key === archiveKey,
    );

    bar.querySelectorAll<HTMLElement>(".group-tab").forEach((tab) => {
      const on = tab.dataset.group === activeGroup;
      setFlag(tab, "data-active", on);
      tab.setAttribute("aria-selected", String(on));
    });

    bar.querySelectorAll<HTMLElement>("[data-sub-of]").forEach((el) => {
      el.hidden = el.dataset.subOf !== activeGroup;
    });

    bar.querySelectorAll<HTMLAnchorElement>(".sub-pill").forEach((pill) => {
      setFlag(
        pill,
        "data-active",
        !!activeItem &&
          keyFromUrl(pill.getAttribute("href") || "", currentUrl.origin) ===
            keyFromUrl(activeItem, currentUrl.origin),
      );
    });
  }

  /** 点一级栏只切换下行内容，不做跳转 */
  function selectGroup(bar: HTMLElement, name: string) {
    bar.dataset.manualGroup = name;
    bar.querySelectorAll<HTMLElement>(".group-tab").forEach((tab) => {
      const on = tab.dataset.group === name;
      setFlag(tab, "data-active", on);
      tab.setAttribute("aria-selected", String(on));
    });
    bar.querySelectorAll<HTMLElement>("[data-sub-of]").forEach((el) => {
      el.hidden = el.dataset.subOf !== name;
    });
  }

  // 文章详情页由「支持与分享」条替代分类栏。
  // 这条栏位于 swup 容器之外，站内无刷新跳转时不会被替换，
  // 所以每次内容更新后都要按当前页型重新同步显隐。
  // 页型判断用「文章卡片是否存在」而不是解析 URL：文章卡片在 swup 容器内、
  // 跳转后必然随内容更新，比硬编码路径规则更不容易失效。
  // `[data-no-category-bar]` 是通用退出标记：书籍落地页、合集页这类「自成一体」
  // 的页面自己声明不要分类栏，不必在这里堆路径判断。
  function syncVisibility() {
    const wrapper = document.getElementById("category-bar-wrapper");
    if (!wrapper) return;
    wrapper.classList.toggle(
      "hidden",
      !!document.querySelector("[data-post-page], [data-no-category-bar]"),
    );
  }

  function updateBar(currentUrl = new URL(window.location.href)) {
    syncVisibility();
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    syncState(bar, currentUrl);
  }

  function init() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    if (bar.dataset.bound !== "true") {
      bar.dataset.bound = "true";
      bar.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const tab = event.target.closest<HTMLElement>(".group-tab");
        if (!tab) return;
        selectGroup(bar, tab.dataset.group || "");
      });
    }

    updateBar();
  }

  init();

  if (!window.__categoryBarInit) {
    window.__categoryBarInit = true;

    document.addEventListener("astro:page-load", () => {
      init();
    });

    document.addEventListener("swup:contentReplaced", () => {
      updateBar();
      // 某些 swup 生命周期下 URL/DOM 状态同步稍晚，下一帧再校正一次避免状态残留
      requestAnimationFrame(() => updateBar());
    });

    const setupEarly = () => {
      window.swup?.hooks?.on("visit:start", (visit: any) => {
        const bar = document.getElementById("category-bar");
        if (!bar) return;
        // 换页后「用户手动选过的栏」不再有约束力，交回地址判断
        delete bar.dataset.manualGroup;
        syncState(bar, new URL(visit.to.url, window.location.href));
      });
    };

    if (window.swup?.hooks) setupEarly();
    else document.addEventListener("swup:enable", setupEarly);
  }
</script>
