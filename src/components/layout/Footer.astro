---
/**
 * 页脚：一张和站内其它区块同款的浅色卡片。
 *
 * 设计要点：
 * - 用 .card-base（与文章卡、侧栏卡同一套圆角与底色），不用深色收底
 *   —— 深色带和这个浅色、圆角的页面风格不搭。
 * - 顶栏：左品牌（站名 + 一句话定位），右上三枚胶囊：
 *   书签导航 / RSS / 留言板。书签导航的开关放在右上角。
 * - 书签抽屉默认收起，点开后从左到右铺开分组链接（宽屏 6 列）。
 * - 版权压成一行，CC BY-NC-SA 4.0 走低对比徽章。
 *
 * 链接数据在 src/config/footerNavConfig.ts，改链接不用动这个组件。
 * site-footer / pointer-events-auto 是 immersive-reading 与首页 banner 的
 * 样式钩子，别删。
 */
import fs from "node:fs";
import path from "node:path";
import { RESOURCE_GROUPS, profileConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();

// 读取 FooterConfig.html 文件内容（保留给临时补充说明用）
let customFooterHtml = "";
try {
	const footerHtmlPath = path.join(
		process.cwd(),
		"src",
		"config",
		"FooterConfig.html",
	);
	customFooterHtml = fs
		.readFileSync(footerHtmlPath, "utf-8")
		.replace(/<!--[\s\S]*?-->/g, "")
		.trim();
} catch {
	// 没有该文件就跳过，不打断构建
}

const GROUP_COUNT = RESOURCE_GROUPS.length;
const SITE_COUNT = RESOURCE_GROUPS.reduce(
	(sum, group) => sum + group.links.length,
	0,
);
---

<footer class="site-footer pointer-events-auto pb-28 md:pb-10">
	<div class="card-base px-6 py-6 md:px-8 md:py-7">
		<!-- 顶栏：品牌 + 右上胶囊 -->
		<div
			class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
		>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
				<div class="flex items-center gap-2">
					<svg
						class="h-5 w-5 text-(--primary)"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.9"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M3 18l6-9 4 6 3-4 5 7"></path>
					</svg>
					<span
						class="transition text-90 text-[0.95rem] font-semibold tracking-wide"
						>{siteConfig.title}</span
					>
				</div>
				<span class="transition text-50 text-xs leading-6"
					>{siteConfig.subtitle}。把想清楚的写下来，把做过的留个底。</span
				>
				{
					customFooterHtml && (
						<span
							class="transition text-50 text-xs"
							set:html={customFooterHtml}
						/>
					)
				}
			</div>

			<div class="flex flex-wrap items-center gap-2">
				<button
					type="button"
					id="footer-bookmarks-toggle"
					class="footer-pill inline-flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1.5 text-xs"
					aria-expanded="false"
					aria-controls="footer-bookmarks"
				>
					<svg
						class="h-3.5 w-3.5 opacity-70"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.9"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M6 3h12a1 1 0 011 1v16l-7-4-7 4V4a1 1 0 011-1z"></path>
					</svg>
					书签导航
					<span class="text-50">{GROUP_COUNT} 组 · {SITE_COUNT} 站</span>
					<svg
						class="footer-chevron h-3.5 w-3.5 opacity-70"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M6 9l6 6 6-6"></path>
					</svg>
				</button>

				<a
					class="footer-pill inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs"
					href={url("rss.xml")}
					target="_blank"
					rel="noopener"
				>
					<svg
						class="h-3.5 w-3.5 opacity-70"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.9"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path
							d="M5 19a1 1 0 100-2 1 1 0 000 2zM5 12a7 7 0 017 7M5 5a14 14 0 0114 14"
						></path>
					</svg>
					RSS
				</a>

				<a
					class="footer-pill inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs"
					href={url("guestbook/")}
				>
					<svg
						class="h-3.5 w-3.5 opacity-70"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.9"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"
						></path>
					</svg>
					留言板
				</a>
			</div>
		</div>

		<!-- 书签抽屉：默认收起，点右上角按钮展开 -->
		<div id="footer-bookmarks" hidden>
			<div class="my-5 h-px bg-black/8 dark:bg-white/10"></div>
			<div
				class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-6"
			>
				{
					RESOURCE_GROUPS.map((group) => (
						<div>
							<div class="transition text-90 text-xs font-semibold mb-1.5">
								{group.title}
							</div>
							<ul class="space-y-0.5">
								{group.links.map((link) => (
									<li>
										<a
											class="transition text-50 text-xs leading-6 hover:text-(--primary)"
											href={link.href}
											target="_blank"
											rel="noopener"
											title={link.hint}
										>
											{link.name}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<!-- 底栏 -->
		<div
			class="mt-6 flex flex-col gap-2 border-t border-dashed border-black/10 pt-4 text-xs sm:flex-row sm:items-center sm:justify-between dark:border-white/15"
		>
			<div
				class="transition text-50 flex flex-wrap items-center gap-x-2 gap-y-1"
			>
				<span
					>&copy; <span id="copyright-year">{currentYear}</span>
					{profileConfig.name}</span
				>
				<span aria-hidden="true">·</span>
				<span>原创内容，转载请注明出处与链接</span>
				<span aria-hidden="true">·</span>
				<span
					class="rounded border border-black/10 px-1.5 py-0.5 text-[0.7rem] dark:border-white/15"
					>CC BY-NC-SA 4.0</span
				>
			</div>

			<div
				class="transition text-50 flex flex-wrap items-center gap-x-2 gap-y-1"
			>
				<!-- 开源署名勿删 -->
				<span>Powered by</span>
				<a
					class="transition link text-(--primary)"
					target="_blank"
					rel="noopener"
					href="https://astro.build">Astro</a
				>
				<span aria-hidden="true">&amp;</span>
				<a
					class="transition link text-(--primary)"
					target="_blank"
					rel="noopener"
					href="https://github.com/CuteLeaf/Firefly">Firefly</a
				>
				<span aria-hidden="true">·</span>
				<a
					class="transition link text-(--primary)"
					target="_blank"
					rel="noopener"
					href={url("atom.xml")}>Atom</a
				>
				<span aria-hidden="true">·</span>
				<a
					class="transition link text-(--primary)"
					target="_blank"
					rel="noopener"
					href={url("sitemap-index.xml")}>Sitemap</a
				>
				<span aria-hidden="true">·</span>
				<button
					type="button"
					id="footer-back-to-top"
					class="transition inline-flex cursor-pointer items-center gap-1 hover:text-(--primary)"
				>
					回到顶部
					<svg
						class="h-3 w-3"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M12 19V5M5 12l7-7 7 7"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</footer>

<style>
	/* 胶囊按钮：与站内其它按钮同一套描边与 hover */
	.footer-pill {
		border: 1px solid rgba(0, 0, 0, 0.09);
		color: var(--text-75, rgba(0, 0, 0, 0.68));
		transition:
			border-color 0.18s ease,
			color 0.18s ease,
			background 0.18s ease;
	}

	.footer-pill:hover {
		border-color: var(--primary);
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 8%, transparent);
	}

	.dark .footer-pill {
		border-color: rgba(255, 255, 255, 0.14);
	}

	.footer-chevron {
		transition: transform 0.2s ease;
	}

	#footer-bookmarks-toggle[aria-expanded="true"] .footer-chevron {
		transform: rotate(180deg);
	}
</style>

<script>
	const bookmarksToggle = document.getElementById("footer-bookmarks-toggle");
	const bookmarksPanel = document.getElementById("footer-bookmarks");

	if (bookmarksToggle && bookmarksPanel) {
		bookmarksToggle.addEventListener("click", () => {
			const open = bookmarksToggle.getAttribute("aria-expanded") === "true";
			bookmarksToggle.setAttribute("aria-expanded", open ? "false" : "true");
			bookmarksPanel.hidden = open;
		});
	}

	const backToTop = document.getElementById("footer-back-to-top");
	backToTop?.addEventListener("click", () => {
		window.scrollTo({ top: 0, behavior: "smooth" });
	});
</script>
