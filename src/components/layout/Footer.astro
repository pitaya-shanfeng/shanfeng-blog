---
/**
 * 页脚：品牌 + 快捷入口 + 声明 + 版权。
 *
 * 「关于」从导航拿掉之后，个人介绍 / 联系合作走头像，版权声明与书签导航落在
 * 这里——所以页脚要能自己站住，不能只是一行版权。
 *
 * site-footer / pointer-events-auto 是 immersive-reading 与首页 banner 的
 * 样式钩子，别删。
 */
import fs from "node:fs";
import path from "node:path";
import { profileConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();

// 读取 FooterConfig.html 文件内容（保留给临时补充说明用）
let customFooterHtml = "";
try {
	const footerHtmlPath = path.join(
		process.cwd(),
		"src",
		"config",
		"FooterConfig.html",
	);
	customFooterHtml = fs
		.readFileSync(footerHtmlPath, "utf-8")
		.replace(/<!--[\s\S]*?-->/g, "")
		.trim();
} catch {
	// 没有该文件就跳过，不打断构建
}

/** 快捷入口：两栏，左边是「关于这个站」，右边是「怎么找我」 */
const LINK_GROUPS = [
	{
		title: "快捷入口",
		links: [
			{ name: "版权声明", href: "/privacy/", external: false },
			{ name: "书签导航", href: "/booknav/", external: false },
			{ name: "友情链接", href: "/friends/", external: false },
			{ name: "留言板", href: "/guestbook/", external: false },
		],
	},
	{
		title: "关于作者",
		links: [
			{ name: "个人介绍", href: "/about/", external: false },
			{ name: "联系合作", href: "/contact/", external: false },
			{ name: "RSS 订阅", href: "/rss.xml", external: true },
		],
	},
];
---

<footer class="site-footer pointer-events-auto pb-24 md:pb-10">
	<div
		class="transition border-t border-dashed border-black/10 dark:border-white/15 mt-10 mb-8 mx-6 md:mx-10"
	>
	</div>

	<div class="px-6 md:px-10">
		<div
			class="transition flex flex-col gap-8 md:flex-row md:items-start md:justify-between"
		>
			<!-- 左：品牌 -->
			<div class="md:max-w-[22rem]">
				<div class="flex items-center gap-2">
					<svg
						class="transition h-6 w-6 text-(--primary)"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M3 18l6-9 4 6 3-4 5 7"></path>
					</svg>
					<span class="transition text-90 font-bold text-lg tracking-wide"
						>{siteConfig.title}</span
					>
				</div>
				<p class="transition text-50 text-sm mt-2 leading-relaxed">
					{siteConfig.subtitle}。把想清楚的写下来，把做过的留个底。
				</p>
				{
					customFooterHtml && (
						<div
							class="transition text-50 text-sm mt-3"
							set:html={customFooterHtml}
						/>
					)
				}
			</div>

			<!-- 右：链接分栏 -->
			<div class="grid grid-cols-2 gap-x-10 gap-y-6 sm:gap-x-16">
				{
					LINK_GROUPS.map((group) => (
						<div>
							<div class="transition text-90 text-sm font-bold mb-3">
								{group.title}
							</div>
							<ul class="space-y-2">
								{group.links.map((link) => (
									<li>
										<a
											class="transition link text-50 text-sm hover:text-(--primary)"
											href={
												link.external
													? url(link.href.slice(1))
													: url(link.href.slice(1))
											}
											target={link.external ? "_blank" : undefined}
											rel={link.external ? "noopener" : undefined}
										>
											{link.name}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<!-- 声明 -->
		<div
			class="transition mt-8 pt-6 border-t border-dashed border-black/10 dark:border-white/15"
		>
			<p class="transition text-50 text-xs leading-relaxed md:max-w-[42rem]">
				站内内容为个人学习与工作整理，参考文献与数据来源已在正文标注；转载、引用请注明出处。
				如涉版权问题，可通过「联系合作」告知，核实后即时处理。
			</p>

			<div
				class="transition mt-4 flex flex-col gap-2 text-50 text-xs sm:flex-row sm:items-center sm:justify-between"
			>
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
					<span
						>&copy; <span id="copyright-year">{currentYear}</span>
						{profileConfig.name}</span
					>
					<span aria-hidden="true">·</span>
					<span>保留所有权利</span>
				</div>
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
					<!-- 开源署名勿删 -->
					<span>Powered by</span>
					<a
						class="transition link text-(--primary)"
						target="_blank"
						rel="noopener"
						href="https://astro.build">Astro</a
					>
					<span aria-hidden="true">&amp;</span>
					<a
						class="transition link text-(--primary)"
						target="_blank"
						rel="noopener"
						href="https://github.com/CuteLeaf/Firefly">Firefly</a
					>
					<span aria-hidden="true">·</span>
					<a
						class="transition link text-(--primary)"
						target="_blank"
						rel="noopener"
						href={url("atom.xml")}>Atom</a
					>
					<span aria-hidden="true">·</span>
					<a
						class="transition link text-(--primary)"
						target="_blank"
						rel="noopener"
						href={url("sitemap-index.xml")}>Sitemap</a
					>
				</div>
			</div>
		</div>
	</div>
</footer>
