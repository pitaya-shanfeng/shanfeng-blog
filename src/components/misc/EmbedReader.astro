---
/**
 * 站内阅读器（外链型转载文章用）
 *
 * 转载只收链接的文章，读者点出去就离开了站点，回来还得再找一次。
 * 这里用 iframe 把原文直接嵌在文章里，顶栏做成浏览器窗口的样子：
 * 左边是站点标识与地址，右边刷新 / 全屏 / 新窗口。
 *
 * 三条现实约束：
 * 1) 目标站可能禁止内嵌（X-Frame-Options / CSP frame-ancestors），
 *    浏览器不给任何可读信号，脚本无法可靠判断，所以底栏常驻一句
 *    「显示不出来就打开新窗口」，不做「加载失败」的假判断。
 * 2) iframe 一律 lazy，且不参与首屏渲染，避免拖慢文章页。
 * 3) 交互（刷新 / 全屏）写在 src/utils/embed-reader.ts，由 Layout 全局装载
 *    —— swup 换页不执行组件脚本。
 */
interface Props {
	href: string;
	/** 顶栏显示的站点标识，缺省按域名推 */
	source?: string;
}

const { href, source } = Astro.props;
const host = (() => {
	try {
		return new URL(href).host.replace(/^www\./, "");
	} catch {
		return href;
	}
})();
const label = source ? `${source} · ${host}` : host;
---

<div class="embed-reader onload-animation" data-embed-reader data-href={href}>
	<div class="er-bar">
		<span class="er-dots" aria-hidden="true">
			<i></i><i></i><i></i>
		</span>
		<span class="er-addr" title={href}>{label}</span>
		<span class="er-actions">
			<button type="button" data-er-reload aria-label="刷新">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
					><path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4.5h-4.5"></path>
				</svg>
			</button>
			<button type="button" data-er-fullscreen aria-label="全屏查看">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
					><path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M4 9V4h5M20 15v5h-5M15 4h5v5M9 20H4v-5"></path>
				</svg>
			</button>
			<a href={href} target="_blank" rel="noopener noreferrer" aria-label="在新窗口打开">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
					><path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M14 4h6v6M20 4l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
				</svg>
			</a>
		</span>
	</div>

	<div class="er-frame">
		<iframe
			src={href}
			title={label}
			loading="lazy"
			referrerpolicy="no-referrer"
			sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
		></iframe>
	</div>

	<p class="er-hint">
		部分站点不允许被嵌入，画面空白时点右上角按钮在新窗口打开。
	</p>
</div>

<style>
	.embed-reader {
		margin: 2rem 0 0;
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
		overflow: hidden;
		background: var(--card-bg);
	}

	.er-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
	}

	.er-dots {
		display: inline-flex;
		gap: 0.3125rem;
		flex-shrink: 0;
	}

	.er-dots i {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--meta-divider);
	}

	.er-addr {
		flex: 1 1 auto;
		min-width: 0;
		padding: 0.1875rem 0.625rem;
		border-radius: 999px;
		background: var(--card-bg);
		font-size: var(--fs-meta);
		line-height: 1.5;
		color: var(--content-meta);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.er-actions {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		flex-shrink: 0;
	}

	.er-actions button,
	.er-actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border: none;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--content-meta);
		cursor: pointer;
		transition: background 0.18s ease, color 0.18s ease;
	}

	.er-actions button:hover,
	.er-actions a:hover {
		background: var(--card-bg);
		color: var(--primary);
	}

	.er-frame {
		position: relative;
		width: 100%;
		height: clamp(28rem, 76vh, 56rem);
		background: var(--card-bg);
	}

	.er-frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.er-hint {
		margin: 0;
		padding: 0.5rem 0.875rem 0.625rem;
		border-top: 1px solid var(--line-divider);
		font-size: var(--fs-label);
		line-height: 1.6;
		color: var(--content-meta);
	}

	/* 全屏：覆盖视口。用 fixed 而不是 requestFullscreen，
	   后者在部分浏览器下退出后要重排，且嵌在 iframe 里容易整块黑 */
	.embed-reader.is-fullscreen {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		margin: 0;
		border: none;
		border-radius: 0;
	}

	.embed-reader.is-fullscreen .er-frame {
		flex: 1 1 auto;
		height: auto;
	}

	.embed-reader.is-fullscreen .er-hint {
		display: none;
	}

	@media (max-width: 767px) {
		.er-frame {
			height: 65vh;
			min-height: 24rem;
		}

		.er-hint {
			padding: 0.5rem 0.75rem;
		}
	}
</style>
