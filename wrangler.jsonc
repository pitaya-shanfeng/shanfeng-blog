{
	// Cloudflare Pages 构建配置。
	// Pages 只认 pages_build_output_dir；assets 是 Worker 的字段，写进来会
	// 报「Configuration file for Pages projects does not support "assets"」。
	"name": "shanfeng-blog",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist"
}
